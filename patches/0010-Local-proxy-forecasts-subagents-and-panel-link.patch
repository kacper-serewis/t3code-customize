+/** Shown only when the proxy's forecast has the routed account running dry before a reset. */
+function ProxyForecastRow({
+  route,
+  now,
+}: {
+  readonly route: ThreadDetailsRoute;
+  readonly now: number;
+}) {
+  const adaptive = proxyAccountCandidate(route.source, route.account.id)?.adaptive;
+  const projections = (
+    [
+      ["5h", "short"],
+      ["Weekly", "long"],
+    ] as const
+  ).flatMap(([label, kind]) => {
+    const window = adaptive?.[kind];
+    const projection = projectRunOut(window, kind, now);
+    return projection ? [{ label, projection, learning: window?.learning ?? false }] : [];
+  });
+  const soonest = projections.toSorted(
+    (left, right) => left.projection.runsOutAt - right.projection.runsOutAt,
+  )[0];
+  if (!soonest) return null;
+  const exhausted = soonest.projection.exhausted;
+  const value = exhausted
+    ? "Out"
+    : `~${formatDuration(Math.max(60_000, soonest.projection.runsOutAt - now))}`;
+  return (
+    <UsageRow
+      label="Forecast"
+      fill={null}
+      tone={exhausted ? "error" : "warning"}
+      value={value}
+      ariaValue={exhausted ? "out of quota" : `runs out in ${value.slice(1)}`}
+      tooltip={
+        <>
+          <span className="text-foreground">
+            {route.account.label} is likely to run out before a reset
+          </span>
+          {projections.map(({ label, projection, learning }) => (
+            <span key={label} className="text-muted-foreground">
+              {projection.exhausted
+                ? `${label}: out until it resets in ${formatDuration(projection.resetAt - now)}`
+                : `${label}: at this pace it runs out in ${formatDuration(
+                    Math.max(60_000, projection.runsOutAt - now),
+                  )}, ${formatDuration(projection.resetAt - projection.runsOutAt)} before it resets`}
+              {learning ? " (still learning usage)" : ""}
+            </span>
+          ))}
+          <span className="text-muted-foreground">Forecast by {route.source.label}</span>
+        </>
+      }
+    />
+  );
+}
+
+/** The chat's subagents and the accounts that served them. */
+function ProxySubagentsRow({
+  route,
+}: {
+  readonly route: Extract<ThreadDetailsRoute, { kind: "session" }>;
+}) {
+  const { entries, agents } = summarizeSubagents(route);
+  if (agents === 0) return null;
+  const accounts = entries.map((entry) => entry.account.label).join(", ");
+  return (
+    <UsageRow
+      label="Subagents"
+      fill={null}
+      tone={null}
+      value={`${agents} · ${accounts}`}
+      ariaValue={`${agents} subagents on ${accounts}`}
+      tooltip={
+        <>
+          <span className="text-foreground">
+            {agents} {agents === 1 ? "subagent" : "subagents"} in this chat
+          </span>
+          {entries.map((entry) => (
+            <span key={entry.accountId} className="text-muted-foreground">
+              {entry.account.email ?? entry.account.label}: {entry.agents}{" "}
+              {entry.agents === 1 ? "agent" : "agents"}, {entry.requests} requests
+            </span>
+          ))}
+        </>
+      }
+    />
+  );
+}
