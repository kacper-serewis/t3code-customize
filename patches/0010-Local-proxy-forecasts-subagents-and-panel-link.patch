+        switches: [],
+        subagents: [
+          { accountId: "other@example.com.json", agents: 1, requests: 3 },
+          { accountId: "claude@example.com.json", agents: 2, requests: 30 },
+        ],
+      },
+    ],
+    next: [
+      {
+        driver: claude,
+        candidates: [
+          { accountId: "cooling.json", unavailable: true, saturated: false },
+          { accountId: "claude@example.com.json", unavailable: false, saturated: true },
