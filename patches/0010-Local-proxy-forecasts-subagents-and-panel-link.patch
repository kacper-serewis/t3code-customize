+export function marksNextChat(window: ServerProviderUsageWindow, driver: string): boolean {
+  return window.kind === "session" || (driver === "codex" && window.kind === "weekly");
+}
+
+/** Accounts the proxy's forecast has running dry before a reset, soonest first. */
+export function collectProxyForecastNotices(
+  presentations: LimitPresentations,
+  now: number,
+): readonly string[] {
+  const found: Array<{ readonly at: number; readonly text: string }> = [];
+  for (const presentation of presentations.values()) {
+    for (const source of presentation.serverConfig?.usageLimitSources ?? []) {
+      for (const queue of source.routing?.next ?? []) {
+        for (const candidate of queue.candidates) {
+          const label = proxyAccountRef(source, candidate.accountId).label;
+          for (const [name, kind] of [
+            ["5h", "short"],
+            ["weekly", "long"],
+          ] as const) {
+            const projection = projectRunOut(candidate.adaptive?.[kind], kind, now);
+            if (!projection || projection.exhausted) continue;
+            const inMs = Math.max(60_000, projection.runsOutAt - now);
+            found.push({
+              at: projection.runsOutAt,
+              text: `${label}: at this pace its ${name} window runs out in ~${formatDuration(inMs)}, ${formatDuration(projection.resetAt - projection.runsOutAt)} before it resets.`,
+            });
+          }
+        }
+      }
+    }
+  }
+  return found.toSorted((left, right) => left.at - right.at).map((entry) => entry.text);
+}
+
+/** Management panels of proxies that serve the fork's endpoints, one per address. */
+export function collectProxyPanels(
+  presentations: LimitPresentations,
+): ReadonlyArray<{ readonly label: string; readonly url: string }> {
+  const panels = new Map<string, string>();
+  for (const presentation of presentations.values()) {
+    for (const source of presentation.serverConfig?.usageLimitSources ?? []) {
+      if (source.panelUrl && !panels.has(source.panelUrl)) {
+        panels.set(source.panelUrl, source.label);
+      }
+    }
+  }
+  return [...panels].map(([url, label]) => ({ label, url }));
+}
