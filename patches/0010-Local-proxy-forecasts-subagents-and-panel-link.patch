diff --git a/apps/web/src/lib/proxyRouting.ts b/apps/web/src/lib/proxyRouting.ts
index 230ea8e93ee..f957f4dbaae 100644
--- a/apps/web/src/lib/proxyRouting.ts
+++ b/apps/web/src/lib/proxyRouting.ts
@@ -111,3 +111,56 @@ export function describeAdaptiveWindow(
   const learning = window.learning ? " (still learning usage)" : "";
   return `${label}: ${share(window.spare)} spare after a ${share(window.reserve)} reserve, ${share(window.used)} used${learning}`;
 }
+
+const HOUR_MS = 60 * 60_000;
+
+export interface RunOutProjection {
+  readonly runsOutAt: number;
+  readonly resetAt: number;
+  /** Already out of quota until the reset. */
+  readonly exhausted: boolean;
+}
+
+/**
+ * When the proxy's own demand forecast says a window runs dry before it resets, and roughly when.
+ * The forecast is the usage expected until the reset (or the proxy's horizon), as a share.
+ */
+export function projectRunOut(
+  window: UsageLimitSourceAdaptiveWindow | undefined,
+  kind: "short" | "long",
+  now: number,
+): RunOutProjection | null {
+  if (!window || window.inactive || !window.reset) return null;
+  const resetAt = Date.parse(window.reset);
+  if (!Number.isFinite(resetAt) || resetAt <= now) return null;
+  if (window.used >= 1) return { runsOutAt: now, resetAt, exhausted: true };
+  if (window.used + window.forecast < 1) return null;
+  const horizonHours = Math.min((resetAt - now) / HOUR_MS, kind === "short" ? 5 : 7 * 24);
+  const rate = window.forecast / horizonHours;
+  if (!(rate > 0)) return null;
+  const runsOutAt = now + ((1 - window.used) / rate) * HOUR_MS;
+  return runsOutAt < resetAt ? { runsOutAt, resetAt, exhausted: false } : null;
+}
+
+/** Subagents of a chat, busiest account first, with labels for the accounts. */
+export function summarizeSubagents(route: ProxySessionRoute) {
+  const entries = (route.session.subagents ?? [])
+    .map((entry) => ({ ...entry, account: proxyAccountRef(route.source, entry.accountId) }))
+    .toSorted((left, right) => right.requests - left.requests);
+  return {
+    entries,
+    agents: entries.reduce((sum, entry) => sum + entry.agents, 0),
+  };
+}
+
+/** The proxy's adaptive view of one account, from its next-chat queue. */
+export function proxyAccountCandidate(
+  source: UsageLimitSourceSnapshot,
+  accountId: string,
+): UsageLimitSourceRoutingCandidate | undefined {
+  for (const queue of source.routing?.next ?? []) {
+    const candidate = queue.candidates.find((entry) => entry.accountId === accountId);
+    if (candidate) return candidate;
+  }
+  return undefined;
+}
