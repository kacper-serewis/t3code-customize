+    const projection = projectRunOut(window({}), "short", now);
+    expect(projection?.exhausted).toBe(false);
+    expect(Math.round((projection!.runsOutAt - now) / 60_000)).toBe(160);
+    expect(projection?.resetAt).toBe(now + 4 * HOUR);
