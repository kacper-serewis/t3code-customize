@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { CUSTOMIZATIONS } from "./registry";
+
+const files = import.meta.glob<{ readonly customization: { readonly id: string } }>(
+  "./features/*.ts",
+  { eager: true },
+);
+
+describe("customizations registry", () => {
+  it("names each feature after its file, which is its patches.json id", () => {
+    for (const [path, module] of Object.entries(files)) {
+      expect(module.customization.id).toBe(path.replace(/^\.\/features\/|\.ts$/g, ""));
+    }
+  });
+
+  it("lists each feature once, with a title and a description", () => {
+    const ids = CUSTOMIZATIONS.map((info) => info.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    expect(ids).toHaveLength(Object.keys(files).length);
+    for (const info of CUSTOMIZATIONS) {
+      expect(info.title.length).toBeGreaterThan(0);
+      expect(info.description.length).toBeGreaterThan(0);
+    }
+  });
+});
diff --git a/apps/web/src/customizations/registry.ts b/apps/web/src/customizations/registry.ts
new file mode 100644
index 0000000000..7fe841dadb
--- /dev/null
+++ b/apps/web/src/customizations/registry.ts
@@ -0,0 +1,52 @@
+import type { UnifiedSettings } from "@t3tools/contracts/settings";
+import { isCustomizationEnabled } from "@t3tools/shared/customizations";
+
+import { usePrimarySettings } from "../hooks/useSettings";
+import { appAtomRegistry } from "../rpc/atomRegistry";
+import { primaryServerSettingsAtom } from "../state/server";
+
+type BooleanSettingKey = {
+  [K in keyof UnifiedSettings]-?: UnifiedSettings[K] extends boolean ? K : never;
+}[keyof UnifiedSettings];
+
+/** A t3code-customize feature as the Customizations settings list shows it. */
+export interface CustomizationInfo {
+  /** The patch id in t3code-customize's patches.json. */
+  readonly id: string;
+  /** Text made with msg(), so it can be translated. */
+  readonly title: string;
+  readonly description: string;
+  /** A feature that already has a switch of its own keeps using it. */
+  readonly settingKey?: BooleanSettingKey;
+  /** Shown under the description when a change needs a reload to apply. */
+  readonly appliesAfterReload?: boolean;
+}
+
+// Each patch adds its own file here, so the list holds exactly the patches that are applied.
+const modules = import.meta.glob<{ readonly customization: CustomizationInfo }>("./features/*.ts", {
+  eager: true,
+});
+
+export const CUSTOMIZATIONS: ReadonlyArray<CustomizationInfo> = Object.values(modules)
+  .map((module) => module.customization)
+  .toSorted((left, right) => left.id.localeCompare(right.id));
+
+export function customizationSwitchOn(settings: UnifiedSettings, info: CustomizationInfo): boolean {
+  return info.settingKey === undefined
+    ? isCustomizationEnabled(settings, info.id)
+    : settings[info.settingKey] === true;
+}
+
+/** Whether a feature is on, following the primary environment's settings. */
+export function useCustomizationEnabled(id: string): boolean {
+  return usePrimarySettings((settings) => isCustomizationEnabled(settings, id));
+}
+
+/** The same check outside React. */
+export function customizationEnabled(id: string): boolean {
+  return isCustomizationEnabled(appAtomRegistry.get(primaryServerSettingsAtom), id);
+}
+
+export function subscribeCustomizations(listener: () => void): () => void {
+  return appAtomRegistry.subscribe(primaryServerSettingsAtom, listener);
+}
