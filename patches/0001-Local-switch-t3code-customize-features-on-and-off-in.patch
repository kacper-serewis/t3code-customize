@@ -0,0 +1,16 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { isCustomizationEnabled } from "./customizations.ts";
+
+describe("isCustomizationEnabled", () => {
+  it("treats a feature without an entry as on", () => {
+    expect(isCustomizationEnabled({}, "stats")).toBe(true);
+    expect(isCustomizationEnabled({ customizations: {} }, "stats")).toBe(true);
+  });
+
+  it("follows the stored switch", () => {
+    const settings = { customizations: { stats: false, "usage-feed": true } };
+    expect(isCustomizationEnabled(settings, "stats")).toBe(false);
+    expect(isCustomizationEnabled(settings, "usage-feed")).toBe(true);
+  });
+});
