@@ -0,0 +1,12 @@
+/**
+ * t3code-customize features can be switched off in Settings without rebuilding. Each one is
+ * known by an id, which matches its entry in the t3code-customize patches.json.
+ */
+export interface CustomizationSettings {
+  readonly customizations?: Readonly<Record<string, boolean>> | undefined;
+}
+
+/** A feature is on unless its id is set to false. */
+export function isCustomizationEnabled(settings: CustomizationSettings, id: string): boolean {
+  return settings.customizations?.[id] ?? true;
+}
