+import { useGT, useMessages } from "gt-react";
+
+import { CUSTOMIZATIONS, customizationSwitchOn } from "../../customizations/registry";
+import { Switch } from "../ui/switch";
+import { SettingsRow, SettingsSection } from "./settingsLayout";
+import { useScopedSettings, useUpdateScopedSettings } from "./useScopedSettings";
+
+/** One switch per t3code-customize feature that is built into this app. */
+export function CustomizationsSettingsSection() {
+  const gt = useGT();
+  const m = useMessages();
+  const settings = useScopedSettings();
+  const updateSettings = useUpdateScopedSettings();
+  if (CUSTOMIZATIONS.length === 0) return null;
+  return (
+    <SettingsSection id="customizations" title={gt("Customizations")}>
+      {CUSTOMIZATIONS.map((info) => {
+        const title = m(info.title);
+        return (
+          <SettingsRow
+            key={info.id}
+            title={title}
+            description={
+              info.appliesAfterReload
+                ? `${m(info.description)} ${gt("Takes effect after a reload.")}`
+                : m(info.description)
+            }
+            settingKeys={info.settingKey === undefined ? ["customizations"] : []}
+            control={
+              <Switch
+                checked={customizationSwitchOn(settings, info)}
+                onCheckedChange={(checked) =>
+                  updateSettings(
+                    info.settingKey === undefined
+                      ? { customizations: { [info.id]: checked } }
+                      : { [info.settingKey]: checked },
+                  )
+                }
+                aria-label={title}
+              />
+            }
+          />
+        );
+      })}
+    </SettingsSection>
+  );
+}
