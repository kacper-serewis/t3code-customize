+import type {
+  ProviderInstanceId,
+  ServerProvider,
+  ServerProviderUsageLimits,
+  UsageLimitSourceSnapshots,
+} from "@t3tools/contracts";
+import {
+  collectLimitPools,
+  collectProviderUsageLimits,
+  displayLimitWindows,
+  type LimitAccount,
+  type LimitPoolWindow,
+  limitsNotice,
+} from "@t3tools/shared/usageLimits";
+
+export type ThreadDetailsLimits =
+  | { readonly kind: "own"; readonly limits: ServerProviderUsageLimits }
+  | { readonly kind: "notice"; readonly notice: string }
+  | {
+      readonly kind: "pooled";
+      readonly windows: readonly LimitPoolWindow[];
+      readonly accountCount: number;
+      readonly sourceLabel: string;
+    };
+
+/**
+ * The limits the thread details card shows for one provider instance. An instance that talks to a
+ * custom endpoint (a CLI proxy) cannot read subscription limits itself, so the card falls back to
+ * the pooled limits of the proxy's accounts for the same driver, as the Usage page shows them.
+ */
+export function resolveThreadDetailsLimits(input: {
+  readonly providerInstanceId: ProviderInstanceId | null;
+  readonly providers: readonly ServerProvider[];
+  readonly sources: UsageLimitSourceSnapshots;
+  readonly now: number;
+}): ThreadDetailsLimits | null {
+  const { providerInstanceId, providers, sources, now } = input;
+  if (providerInstanceId === null) return null;
+  const provider = providers.find((candidate) => candidate.instanceId === providerInstanceId);
+  const report = collectProviderUsageLimits(providerInstanceId, providers, sources, now);
+  // Only this instance's data: other native entries may be a different login or workspace.
+  const own =
+    report?.accounts.find((entry) => entry.instanceId === providerInstanceId)?.limits ??
+    provider?.usageLimits;
+  const notice = own ? limitsNotice(own) : null;
+  if (own && notice === null) return { kind: "own", limits: own };
+
+  const routesThroughProxy = provider?.auth.type === "customEndpoint" || own === undefined;
+  const proxied = routesThroughProxy
+    ? (report?.accounts ?? []).filter(
+        (entry) =>
+          entry.instanceId === undefined &&
+          entry.sourceLabel !== undefined &&
+          limitsNotice(entry.limits) === null,
+      )
+    : [];
+  if (proxied.length > 0) {
+    const accounts = proxied.map(
+      (entry): LimitAccount => ({
+        key: entry.id,
+        driver: entry.driver,
+        displayName: entry.displayName ?? null,
+        email: entry.email,
+        plan: entry.plan,
+        accentColor: entry.accentColor,
+        environments: [],
+        sourceLabel: entry.sourceLabel ?? null,
+        redeem: null,
+        limits: entry.limits,
+      }),
+    );
+    const pool = collectLimitPools(accounts, now)[0];
+    if (pool && pool.windows.length > 0) {
+      return {
+        kind: "pooled",
+        windows: displayLimitWindows(pool),
+        accountCount: accounts.length,
+        sourceLabel: proxied[0]!.sourceLabel!,
+      };
+    }
+  }
+  return own && notice !== null ? { kind: "notice", notice } : null;
+}
