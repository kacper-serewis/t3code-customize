+/** A window pooled across a proxy's accounts; it reads like the Usage page's summary. */
+function PooledLimitRow({
+  window,
+  now,
+  accountCount,
+  sourceLabel,
+}: {
+  readonly window: LimitPoolWindow;
+  readonly now: number;
+  readonly accountCount: number;
+  readonly sourceLabel: string;
+}) {
+  const timestampFormat = usePrimarySettings((settings) => settings.timestampFormat);
+  const left = window.remainingPercent;
+  const nextReset = window.resets.find((reset) => reset.at > now);
+  return (
+    <UsageRow
+      label={window.label}
+      fill={left}
+      tone={left <= 10 ? "error" : left <= 20 ? "warning" : null}
+      value={`${left}%`}
+      ariaValue={`${left}% left across ${accountCount} accounts`}
+      tooltip={
+        <>
+          <span className="text-foreground">
+            {window.label}: {left}% left
+          </span>
+          <span className="text-muted-foreground">
+            Pooled across {accountCount} {accountCount === 1 ? "account" : "accounts"} from{" "}
+            {sourceLabel}
+          </span>
+          {nextReset ? (
+            <span className="text-muted-foreground">
+              Next reset in {formatDuration(nextReset.at - now)} ·{" "}
+              {formatUpcomingTimestamp(new Date(nextReset.at).toISOString(), timestampFormat, now)}
+            </span>
+          ) : null}
+          {window.pace ? (
+            <span className="text-muted-foreground">{PACE_LABEL[window.pace]}</span>
+          ) : null}
+        </>
+      }
+    />
+  );
+}
