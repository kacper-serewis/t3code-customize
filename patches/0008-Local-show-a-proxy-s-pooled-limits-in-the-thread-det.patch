+import {
+  ProviderDriverKind,
+  ProviderInstanceId,
+  type ServerProvider,
+  type ServerProviderUsageLimits,
+  type UsageLimitSourceSnapshots,
+  UsageLimitSourceId,
+} from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { resolveThreadDetailsLimits } from "./ThreadDetailsUsage.logic";
+
+const now = Date.parse("2026-11-02T22:00:00.000Z");
+const checkedAt = "2026-11-02T21:59:00.000Z";
+const HOUR = 60 * 60_000;
+const instanceId = ProviderInstanceId.make("claudeAgent");
+
+function limits(sessionUsed: number, weeklyUsed: number): ServerProviderUsageLimits {
+  return {
+    checkedAt,
+    windows: [
+      {
+        id: "five_hour",
+        kind: "session",
+        label: "Session",
+        usedPercent: sessionUsed,
+        resetsAt: new Date(now + 2 * HOUR).toISOString(),
+        windowDurationMins: 300,
+        checkedAt,
+      },
+      {
+        id: "seven_day",
+        kind: "weekly",
+        label: "Weekly",
+        usedPercent: weeklyUsed,
+        resetsAt: new Date(now + 40 * HOUR).toISOString(),
+        windowDurationMins: 7 * 24 * 60,
+        checkedAt,
+      },
+    ],
+  };
+}
+
+const probeFailed: ServerProviderUsageLimits = {
+  checkedAt,
+  windows: [],
+  unavailable: { reason: "probeFailed" },
+};
+
+function provider(
+  usageLimits: ServerProviderUsageLimits | undefined,
+  auth: ServerProvider["auth"],
+): ServerProvider {
+  return {
+    instanceId,
+    driver: ProviderDriverKind.make("claudeAgent"),
+    enabled: true,
+    installed: true,
+    version: "2.1.300",
+    status: "ready",
+    auth,
+    checkedAt,
+    models: [],
+    slashCommands: [],
+    skills: [],
+    ...(usageLimits ? { usageLimits } : {}),
+  };
+}
+
+const viaProxy = { status: "authenticated", type: "customEndpoint" } as const;
+const subscription = { status: "authenticated", type: "max" } as const;
+
+function proxySource(
+  accounts: ReadonlyArray<{ id: string; driver?: string; limits: ServerProviderUsageLimits }>,
+): UsageLimitSourceSnapshots {
+  return [
+    {
+      id: UsageLimitSourceId.make("hub"),
+      kind: "cliproxy",
+      label: "HUB",
+      checkedAt,
+      accounts: accounts.map((account) => ({
+        id: account.id,
+        driver: ProviderDriverKind.make(account.driver ?? "claudeAgent"),
+        email: `${account.id}@example.com`,
+        usageLimits: account.limits,
+      })),
+    },
+  ];
+}
+
+const threeAccounts = proxySource([
+  { id: "cs", limits: limits(0, 6) },
+  { id: "ds", limits: limits(0, 17) },
+  { id: "ts", limits: limits(0, 29) },
+]);
+
+describe("resolveThreadDetailsLimits", () => {
+  it("shows the instance's own limits when it can read them", () => {
+    const own = limits(30, 40);
+    expect(
+      resolveThreadDetailsLimits({
+        providerInstanceId: instanceId,
+        providers: [provider(own, subscription)],
+        sources: threeAccounts,
+        now,
+      }),
+    ).toEqual({ kind: "own", limits: own });
+  });
+
+  it("pools the proxy's accounts for an instance behind a custom endpoint", () => {
+    const result = resolveThreadDetailsLimits({
+      providerInstanceId: instanceId,
+      providers: [provider(probeFailed, viaProxy)],
+      sources: threeAccounts,
+      now,
+    });
+    expect(result?.kind).toBe("pooled");
+    if (result?.kind !== "pooled") return;
+    expect(result.accountCount).toBe(3);
+    expect(result.sourceLabel).toBe("CLI Proxy");
+    expect(result.windows.map((window) => [window.label, window.remainingPercent])).toEqual([
+      ["Session", 100],
+      ["Weekly", 83],
+    ]);
+  });
+
+  it("keeps a subscription's own failure instead of borrowing another login's limits", () => {
+    expect(
+      resolveThreadDetailsLimits({
+        providerInstanceId: instanceId,
+        providers: [provider(probeFailed, subscription)],
+        sources: threeAccounts,
+        now,
+      }),
+    ).toEqual({ kind: "notice", notice: "Could not read limits." });
+  });
+
+  it("reports the failure when the proxy has no usable account for the driver", () => {
+    const codexOnly = proxySource([{ id: "ds", driver: "codex", limits: limits(10, 60) }]);
+    const failedClaude = proxySource([{ id: "cs", limits: probeFailed }]);
+    for (const sources of [[], codexOnly, failedClaude]) {
+      expect(
+        resolveThreadDetailsLimits({
+          providerInstanceId: instanceId,
+          providers: [provider(probeFailed, viaProxy)],
+          sources,
+          now,
+        }),
+      ).toEqual({ kind: "notice", notice: "Could not read limits." });
+    }
+  });
+
+  it("returns nothing without a selected instance", () => {
+    expect(
+      resolveThreadDetailsLimits({
+        providerInstanceId: null,
+        providers: [provider(probeFailed, viaProxy)],
+        sources: threeAccounts,
+        now,
+      }),
+    ).toBeNull();
+  });
+});
