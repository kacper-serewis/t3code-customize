diff --git a/apps/server/src/benchmarks/ModelBenchmarkService.ts b/apps/server/src/benchmarks/ModelBenchmarkService.ts
new file mode 100644
index 0000000000..c5df334be0
--- /dev/null
+++ b/apps/server/src/benchmarks/ModelBenchmarkService.ts
@@ -0,0 +1,198 @@
+import {
+  MODEL_BENCHMARKS_SOURCE_URL,
+  ModelBenchmark,
+  type ModelBenchmarks,
+} from "@t3tools/contracts";
+import { writeFileStringAtomically } from "@t3tools/shared/atomicWrite";
+import * as HostProcess from "@t3tools/shared/HostProcess";
+import * as Clock from "effect/Clock";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+import { HttpClient } from "effect/http";
+
+import * as ServerConfig from "../config.ts";
+import {
+  ARTIFICIAL_ANALYSIS_MODELS_URL,
+  groupModelBenchmarks,
+  parseArtificialAnalysisPage,
+  type ArtificialAnalysisPage,
+  type ArtificialAnalysisRow,
+} from "./artificialAnalysis.ts";
+
+/** The key comes from this variable, or else from this file in the state directory. */
+export const ARTIFICIAL_ANALYSIS_KEY_ENV = "ARTIFICIAL_ANALYSIS_API_KEY";
+export const ARTIFICIAL_ANALYSIS_KEY_FILE = "artificial-analysis-api-key";
+const CACHE_FILE = "artificial-analysis-models.json";
+
+// The free tier allows 100 requests a day and a full list is a few pages, so fetch daily.
+const TTL_MS = 24 * 60 * 60 * 1000;
+// A refused key or an outage waits this long before the next try.
+const RETRY_AFTER_FAILURE_MS = 60 * 60 * 1000;
+const MAX_PAGES = 10;
+
+const CacheFile = Schema.Struct({
+  fetchedAtMs: Schema.Number,
+  intelligenceIndexVersion: Schema.NullOr(Schema.Number),
+  models: Schema.Array(ModelBenchmark),
+});
+type PageResult =
+  | { readonly ok: true; readonly page: ArtificialAnalysisPage }
+  | { readonly ok: false; readonly status: number | null };
+
+const decodeCache = Schema.decodeUnknownEffect(Schema.fromJsonString(CacheFile));
+const encodeCache = Schema.encodeEffect(Schema.fromJsonString(CacheFile));
+
+export class ModelBenchmarkService extends Context.Service<
+  ModelBenchmarkService,
+  {
+    /** The scores, fetching them first when older than a day. Never fails. */
+    readonly read: Effect.Effect<ModelBenchmarks>;
+  }
+>()("t3/benchmarks/ModelBenchmarkService") {}
+
+export function describeFetchFailure(status: number | null): string {
+  if (status === 401 || status === 403) return "Artificial Analysis refused the API key.";
+  if (status === 429) return "The daily Artificial Analysis request limit is used up.";
+  return "Could not reach Artificial Analysis.";
+}
+
+export const make = Effect.gen(function* () {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const config = yield* ServerConfig.ServerConfig;
+  const httpClient = yield* HttpClient.HttpClient;
+  const hostEnvironment = yield* HostProcess.Environment;
+  const keyPath = path.join(config.stateDir, ARTIFICIAL_ANALYSIS_KEY_FILE);
+  const cachePath = path.join(config.stateDir, CACHE_FILE);
+  const lock = yield* Semaphore.make(1);
+
+  let models: ModelBenchmarks["models"] = [];
+  let intelligenceIndexVersion: number | null = null;
+  let fetchedAtMs: number | null = null;
+  let lastFailedAtMs: number | null = null;
+  let failure: string | null = null;
+  let configured = false;
+
+  // Read on every refresh, so a key added later needs no restart.
+  const readKey = Effect.gen(function* () {
+    const fromEnv = hostEnvironment[ARTIFICIAL_ANALYSIS_KEY_ENV]?.trim();
+    if (fromEnv) return fromEnv;
+    const fromFile = yield* fileSystem.readFileString(keyPath).pipe(Effect.option);
+    return Option.isSome(fromFile) ? fromFile.value.trim() : "";
+  });
+
+  const loadCache = yield* Effect.cached(
+    fileSystem.readFileString(cachePath).pipe(
+      Effect.flatMap((raw) => decodeCache(raw)),
+      Effect.map((saved) => {
+        models = saved.models;
+        intelligenceIndexVersion = saved.intelligenceIndexVersion;
+        fetchedAtMs = saved.fetchedAtMs;
+      }),
+      Effect.ignoreCause,
+    ),
+  );
+
+  const fetchPage = (key: string, page: number): Effect.Effect<PageResult> =>
+    httpClient
+      .get(`${ARTIFICIAL_ANALYSIS_MODELS_URL}?page=${page}`, {
+        headers: { accept: "application/json", "x-api-key": key },
+      })
+      .pipe(
+        Effect.flatMap((response): Effect.Effect<PageResult, unknown> =>
+          response.status >= 200 && response.status < 300
+            ? response.json.pipe(
+                Effect.map((document) => ({
+                  ok: true as const,
+                  page: parseArtificialAnalysisPage(document),
+                })),
+              )
+            : Effect.succeed({ ok: false as const, status: response.status }),
+        ),
+        Effect.timeout(15_000),
+        Effect.catchCause(() => Effect.succeed({ ok: false as const, status: null })),
+      );
+
+  const fetchAll = Effect.fn("ModelBenchmarkService.fetchAll")(function* (key: string) {
+    const rows: ArtificialAnalysisRow[] = [];
+    let version: number | null = null;
+    for (let page = 1; page <= MAX_PAGES; page++) {
+      const result = yield* fetchPage(key, page);
+      if (!result.ok) return { ok: false as const, status: result.status };
+      rows.push(...result.page.rows);
+      version ??= result.page.intelligenceIndexVersion;
+      if (!result.page.hasMore) break;
+    }
+    return { ok: true as const, rows, version };
+  });
+
+  const refresh = Effect.fn("ModelBenchmarkService.refresh")(function* () {
+    yield* loadCache;
+    const key = yield* readKey;
+    configured = key.length > 0;
+    if (!configured) return;
+    const now = yield* Clock.currentTimeMillis;
+    if (fetchedAtMs !== null && now - fetchedAtMs < TTL_MS) return;
+    if (lastFailedAtMs !== null && now - lastFailedAtMs < RETRY_AFTER_FAILURE_MS) return;
+
+    const result = yield* fetchAll(key);
+    const grouped = result.ok ? groupModelBenchmarks(result.rows) : [];
+    if (!result.ok || grouped.length === 0) {
+      lastFailedAtMs = now;
+      failure = describeFetchFailure(result.ok ? null : result.status);
+      yield* Effect.logWarning("Could not fetch model benchmarks.", { failure });
+      return;
+    }
+    models = grouped;
+    intelligenceIndexVersion = result.version;
+    fetchedAtMs = now;
+    lastFailedAtMs = null;
+    failure = null;
+    yield* encodeCache({ fetchedAtMs: now, intelligenceIndexVersion, models }).pipe(
+      Effect.flatMap((contents) =>
+        writeFileStringAtomically({ filePath: cachePath, contents }).pipe(
+          Effect.provideService(FileSystem.FileSystem, fileSystem),
+          Effect.provideService(Path.Path, path),
+        ),
+      ),
+      Effect.ignoreCause,
+    );
+  });
+
+  const snapshot = (now: number): ModelBenchmarks => {
+    const fresh = fetchedAtMs !== null && now - fetchedAtMs < TTL_MS && failure === null;
+    return {
+      status: !configured
+        ? models.length > 0
+          ? "cached"
+          : "unconfigured"
+        : models.length === 0
+          ? "unavailable"
+          : fresh
+            ? "fresh"
+            : "cached",
+      source: MODEL_BENCHMARKS_SOURCE_URL,
+      fetchedAt: fetchedAtMs === null ? null : DateTime.formatIso(DateTime.makeUnsafe(fetchedAtMs)),
+      intelligenceIndexVersion,
+      message: !configured
+        ? `Add a free Artificial Analysis API key to ${keyPath} or set ${ARTIFICIAL_ANALYSIS_KEY_ENV}.`
+        : failure,
+      models,
+    };
+  };
+
+  const read = lock
+    .withPermit(refresh())
+    .pipe(Effect.ignoreCause, Effect.andThen(Clock.currentTimeMillis), Effect.map(snapshot));
+
+  return { read } as const;
+});
+
+export const layer = Layer.effect(ModelBenchmarkService, make);
diff --git a/apps/server/src/benchmarks/artificialAnalysis.test.ts b/apps/server/src/benchmarks/artificialAnalysis.test.ts
new file mode 100644
index 0000000000..5a97d07c24
--- /dev/null
