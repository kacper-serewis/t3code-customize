index 0000000000..9a8ca829d8
--- /dev/null
+++ b/apps/web/src/lib/modelBenchmarks.ts
@@ -0,0 +1,116 @@
+import type { ModelBenchmark, ModelBenchmarkVariant } from "@t3tools/contracts";
+
+/**
+ * Matches T3's model ids to Artificial Analysis entries and words what the picker shows. T3 ids
+ * come as `claude-opus-5-5`, `gpt-5.6-sol`, `openai/gpt-6-luna`, `claude-opus-5-5-20260101` or
+ * `claude-opus-5-5[1m]`; the source uses `claude-opus-5-5`, `gpt-5-6-sol` and `gpt-6-luna`.
+ */
+export function normalizeModelSlug(slug: string): string {
+  return (slug.split("/").at(-1) ?? slug)
+    .trim()
+    .toLowerCase()
+    .replace(/\[[^\]]*\]$/, "")
+    .replace(/[._\s]+/g, "-")
+    .replace(/-(?:latest|\d{8})$/, "");
+}
+
+const indexes = new WeakMap<ReadonlyArray<ModelBenchmark>, ReadonlyMap<string, ModelBenchmark>>();
+
+function indexBySlug(models: ReadonlyArray<ModelBenchmark>): ReadonlyMap<string, ModelBenchmark> {
+  let index = indexes.get(models);
+  if (!index) {
+    index = new Map(models.map((model) => [model.slug, model]));
+    indexes.set(models, index);
+  }
+  return index;
+}
+
+export function findModelBenchmark(
+  models: ReadonlyArray<ModelBenchmark> | null | undefined,
+  slug: string,
+): ModelBenchmark | null {
+  if (!models || models.length === 0) return null;
+  return indexBySlug(models).get(normalizeModelSlug(slug)) ?? null;
+}
+
+/** The variant for one effort option id; `ultrathink` and `ultracode` run at the top level. */
+export function benchmarkVariantForEffort(
+  model: ModelBenchmark,
+  effort: string | null | undefined,
+): ModelBenchmarkVariant | null {
+  if (!effort) return null;
+  const id = effort.toLowerCase();
+  const wanted = id === "ultrathink" ? "max" : id === "extra-high" ? "xhigh" : id;
+  return model.variants.find((variant) => variant.effort === wanted) ?? null;
+}
+
+/** The highest-scoring variant, for a model row that shows one number. */
+export function bestBenchmarkVariant(model: ModelBenchmark): ModelBenchmarkVariant | null {
+  let best: ModelBenchmarkVariant | null = null;
+  for (const variant of model.variants) {
+    if (variant.intelligenceIndex === null) continue;
+    if (!best || variant.intelligenceIndex > (best.intelligenceIndex ?? -Infinity)) best = variant;
+  }
+  return best;
+}
+
+export function formatBenchmarkScore(score: number | null): string | null {
+  return score === null ? null : score.toFixed(score >= 100 ? 0 : 1).replace(/\.0$/, "");
+}
+
+const EFFORT_NAMES: Readonly<Record<string, string>> = {
+  none: "No reasoning",
+  minimal: "Minimal",
+  low: "Low",
+  medium: "Medium",
+  high: "High",
+  xhigh: "Extra High",
+  max: "Max",
+};
+
+function money(value: number): string {
+  return value >= 1 ? `$${value.toFixed(2)}` : `$${value.toFixed(value >= 0.1 ? 2 : 3)}`;
+}
+
+/** One variant's measurements as short phrases, best first. */
+export function describeBenchmarkVariant(variant: ModelBenchmarkVariant): ReadonlyArray<string> {
+  const score = formatBenchmarkScore(variant.intelligenceIndex);
+  return [
+    score === null ? "No Intelligence Index yet" : `Intelligence ${score}`,
+    variant.outputTokensPerSecond === null
+      ? null
+      : `${Math.round(variant.outputTokensPerSecond)} tok/s`,
+    variant.costPerTaskUsd === null ? null : `${money(variant.costPerTaskUsd)} per task`,
+  ].filter((part): part is string => part !== null);
+}
+
+/** Every measured effort, lowest first, as "High: 51.8". */
+export function describeBenchmarkEfforts(model: ModelBenchmark): string {
+  return model.variants
+    .filter((variant) => variant.intelligenceIndex !== null)
+    .map(
+      (variant) =>
+        `${variant.effort ? (EFFORT_NAMES[variant.effort] ?? variant.effort) : "Default"}: ${formatBenchmarkScore(variant.intelligenceIndex)}`,
+    )
+    .join(" · ");
+}
+
+export function describeBenchmarkPrice(model: ModelBenchmark): string | null {
+  const { inputPricePerMillionTokens: input, outputPricePerMillionTokens: output } = model;
+  if (input === null || output === null) return null;
+  return `$${input} in / $${output} out per 1M tokens`;
+}
+
+/**
+ * How a score sits among the model's own efforts, 0 to 1, for a bar. Relative to the model's
+ * best, so the levels compare at a glance.
+ */
+export function benchmarkScoreShare(
+  model: ModelBenchmark,
+  variant: ModelBenchmarkVariant | null,
+): number | null {
+  const best = bestBenchmarkVariant(model)?.intelligenceIndex ?? null;
+  const score = variant?.intelligenceIndex ?? null;
+  if (best === null || score === null || best <= 0) return null;
+  return Math.max(0, Math.min(1, score / best));
+}
