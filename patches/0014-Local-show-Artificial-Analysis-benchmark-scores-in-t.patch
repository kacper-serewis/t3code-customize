+import { useAtomValue } from "@effect/atom-react";
+import type { ModelBenchmarks } from "@t3tools/contracts";
+import { AsyncResult, Atom } from "effect/reactivity";
+
+import { useCustomizationEnabled } from "../customizations/registry";
+import { environmentSummaries } from "./presentation";
+import { primaryEnvironmentIdAtom } from "./primaryEnvironment";
+import { serverEnvironment } from "./server";
+
+/**
+ * Benchmark scores from the local server, which holds the Artificial Analysis key. Without a
+ * local server, the first connected one answers. Null until loaded or when no server has them.
+ */
+export const modelBenchmarksAtom = Atom.make((get): ModelBenchmarks | null => {
+  const primary = get(primaryEnvironmentIdAtom);
+  const environmentId = primary ?? get(environmentSummaries.connectedEnvironmentIdsAtom)[0];
+  if (environmentId === undefined) return null;
+  const result = get(serverEnvironment.modelBenchmarks({ environmentId, input: {} }));
+  return AsyncResult.getOrElse(result, () => null);
+}).pipe(Atom.withLabel("web-model-benchmarks"));
+
+const noModelBenchmarksAtom = Atom.make((): ModelBenchmarks | null => null).pipe(
+  Atom.withLabel("web-model-benchmarks-off"),
+);
+
+/** Off in Settings → Customizations, the picker shows no scores and never asks the server. */
+export function useModelBenchmarks(): ModelBenchmarks | null {
+  const benchmarksOn = useCustomizationEnabled("model-benchmarks");
+  return useAtomValue(benchmarksOn ? modelBenchmarksAtom : noModelBenchmarksAtom);
+}
