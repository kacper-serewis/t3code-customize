@@ -0,0 +1,173 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  groupModelBenchmarks,
+  parseArtificialAnalysisPage,
+  splitVariantName,
+} from "./artificialAnalysis.ts";
+import { describeFetchFailure } from "./ModelBenchmarkService.ts";
+
+function apiRow(
+  name: string,
+  slug: string,
+  index: number | null,
+  tokensPerSecond: number | null = 100,
+  creator = "Anthropic",
+) {
+  return {
+    id: slug,
+    name,
+    slug,
+    release_date: "2026-09-28",
+    model_creator: { id: creator, name: creator },
+    evaluations: {
+      artificial_analysis_intelligence_index: index,
+      artificial_analysis_coding_index: null,
+      artificial_analysis_agentic_index: null,
+    },
+    artificial_analysis_intelligence_index_cost:
+      index === null ? null : { total_cost: 1000, cost_per_task: { total_cost: index / 10 } },
+    pricing: { price_1m_input_tokens: 4, price_1m_output_tokens: 20 },
+    performance: { median_output_tokens_per_second: 1, median_time_to_first_token_seconds: 9 },
+    performance_v3:
+      tokensPerSecond === null
+        ? null
+        : { mean_output_tokens_per_second: tokensPerSecond, mean_time_to_first_token_seconds: 2.5 },
+  };
+}
+
+describe("parseArtificialAnalysisPage", () => {
+  it("reads rows, pagination and the index version, preferring v3 performance", () => {
+    const page = parseArtificialAnalysisPage({
+      tier: "free",
+      intelligence_index_version: 5,
+      pagination: { page: 1, page_size: 200, total_pages: 2, has_more: true },
+      data: [apiRow("Claude Opus 5.5 (High, Default Fallback)", "claude-opus-5-5-high", 51.8)],
+    });
+    expect(page.hasMore).toBe(true);
+    expect(page.intelligenceIndexVersion).toBe(5);
+    expect(page.rows).toEqual([
+      {
+        slug: "claude-opus-5-5-high",
+        name: "Claude Opus 5.5 (High, Default Fallback)",
+        creator: "Anthropic",
+        intelligenceIndex: 51.8,
+        outputTokensPerSecond: 100,
+        timeToFirstTokenSeconds: 2.5,
+        costPerTaskUsd: 5.18,
+        inputPricePerMillionTokens: 4,
+        outputPricePerMillionTokens: 20,
+      },
+    ]);
+  });
+
+  it("falls back to legacy performance and skips rows without a name or slug", () => {
+    const page = parseArtificialAnalysisPage({
+      pagination: { has_more: false },
+      data: [apiRow("Old (Low)", "old-low", null, null), { slug: "nameless" }, null],
+    });
+    expect(page.hasMore).toBe(false);
+    expect(page.rows.map((row) => [row.slug, row.outputTokensPerSecond])).toEqual([["old-low", 1]]);
+  });
+
+  it("tolerates a body that is not the expected shape", () => {
+    expect(parseArtificialAnalysisPage("nope")).toEqual({
+      rows: [],
+      hasMore: false,
+      intelligenceIndexVersion: null,
+    });
+  });
+});
+
+describe("splitVariantName", () => {
+  it("reads the effort and drops fallback notes", () => {
+    expect(splitVariantName("Claude Opus 5.5 (Xhigh, Default Fallback)")).toEqual({
+      base: "Claude Opus 5.5",
+      effort: "xhigh",
+      qualifiers: [],
+    });
+    expect(splitVariantName("Claude Fable 5 (Max, Opus 4.8 Fallback)").effort).toBe("max");
+  });
+
+  it("maps non-reasoning to none and keeps other qualifiers", () => {
+    expect(splitVariantName("GPT-6 Luna (Non-reasoning)").effort).toBe("none");
+    expect(splitVariantName("Claude Sonnet 5 (Non-reasoning, High)").effort).toBe("none");
+    expect(splitVariantName("GPT-6 Sol (Daybreak Blue, max)")).toEqual({
+      base: "GPT-6 Sol",
+      effort: "max",
+      qualifiers: ["Daybreak Blue"],
+    });
+    expect(splitVariantName("GPT-5.5 Instant (June 2026)")).toEqual({
+      base: "GPT-5.5 Instant",
+      effort: null,
+      qualifiers: ["June 2026"],
+    });
+    expect(splitVariantName("Claude 3.5 Haiku")).toEqual({
+      base: "Claude 3.5 Haiku",
+      effort: null,
+      qualifiers: [],
+    });
+  });
+});
+
+describe("groupModelBenchmarks", () => {
+  const rows = parseArtificialAnalysisPage({
+    data: [
+      apiRow("Claude Opus 5.5 (Max, Default Fallback)", "claude-opus-5-5", 59.1),
+      apiRow("Claude Opus 5.5 (Low, Default Fallback)", "claude-opus-5-5-low", 34.8),
+      apiRow("Claude Opus 5.5 (Xhigh, Default Fallback)", "claude-opus-5-5-xhigh", 57.4),
+      apiRow("Claude Opus 5.5 (High, Default Fallback)", "claude-opus-5-5-high", 51.8),
+      apiRow("Claude Opus 5.5 (Medium, Default Fallback)", "claude-opus-5-5-medium", 48.2),
+      // The default effort carries the bare slug, whichever effort it is.
+      apiRow("Gemini 4 Hydrogen (Xhigh)", "gemini-4-hydrogen", 53.9, 173, "Google"),
+      apiRow("Gemini 4 Hydrogen (Low)", "gemini-4-hydrogen-low", 26.9, 166, "Google"),
+      apiRow("GPT-6 Sol (Daybreak Blue, max)", "gpt-6-sol-daybreak-blue", null, 90, "OpenAI"),
+      apiRow("GPT-6 Sol (Max)", "gpt-6-sol", 44.2, 122, "OpenAI"),
+      {
+        ...apiRow("Claude 3.5 Haiku", "claude-3-5-haiku", null, null),
+        performance: { median_output_tokens_per_second: null },
+      },
+    ],
+  }).rows;
+  const models = groupModelBenchmarks(rows);
+
+  it("folds every effort of a model into one entry, lowest effort first", () => {
+    const opus = models.find((model) => model.slug === "claude-opus-5-5");
+    expect(opus?.name).toBe("Claude Opus 5.5");
+    expect(opus?.creator).toBe("Anthropic");
+    expect(opus?.inputPricePerMillionTokens).toBe(4);
+    expect(opus?.variants.map((variant) => [variant.effort, variant.intelligenceIndex])).toEqual([
+      ["low", 34.8],
+      ["medium", 48.2],
+      ["high", 51.8],
+      ["xhigh", 57.4],
+      ["max", 59.1],
+    ]);
+  });
+
+  it("takes the model's slug from what every effort's slug shortens to", () => {
+    expect(models.find((model) => model.name === "Gemini 4 Hydrogen")?.slug).toBe(
+      "gemini-4-hydrogen",
+    );
+  });
+
+  it("keeps a named edition apart from the model and drops models with nothing measured", () => {
+    expect(models.map((model) => model.slug)).toEqual([
+      "claude-opus-5-5",
+      "gemini-4-hydrogen",
+      "gpt-6-sol",
+      "gpt-6-sol-daybreak-blue",
+    ]);
+    expect(models.find((model) => model.slug === "gpt-6-sol-daybreak-blue")?.name).toBe(
+      "GPT-6 Sol (Daybreak Blue)",
+    );
+  });
+});
+
+describe("describeFetchFailure", () => {
+  it("names a refused key and a spent quota", () => {
+    expect(describeFetchFailure(401)).toMatch(/refused the API key/);
+    expect(describeFetchFailure(429)).toMatch(/limit/);
+    expect(describeFetchFailure(null)).toMatch(/Could not reach/);
+  });
+});
diff --git a/apps/server/src/benchmarks/artificialAnalysis.ts b/apps/server/src/benchmarks/artificialAnalysis.ts
new file mode 100644
index 0000000000..49281b337f
--- /dev/null
+++ b/apps/server/src/benchmarks/artificialAnalysis.ts
@@ -0,0 +1,201 @@
+import type { ModelBenchmark, ModelBenchmarkVariant } from "@t3tools/contracts";
+
+/**
+ * Artificial Analysis lists every measured configuration as its own model, with the effort in the
+ * name: "Claude Opus 5.5 (High, Default Fallback)", slug `claude-opus-5-5-high`. The model at its
+ * default effort has the bare slug, `claude-opus-5-5`. These helpers fold those rows back into one
+ * model with a variant per effort.
+ */
+
+export const ARTIFICIAL_ANALYSIS_MODELS_URL =
+  "https://artificialanalysis.ai/api/v2/language/models/free";
+
+/** Effort words in the source's names, as T3's effort option ids. */
+const EFFORT_WORDS: Readonly<Record<string, string>> = {
+  "non-reasoning": "none",
+  minimal: "minimal",
+  low: "low",
+  medium: "medium",
+  high: "high",
+  xhigh: "xhigh",
+  "extra high": "xhigh",
+  max: "max",
+};
+
+/** Lowest to highest, for display order. */
+export const EFFORT_ORDER: ReadonlyArray<string> = [
+  "none",
+  "minimal",
+  "low",
+  "medium",
+  "high",
+  "xhigh",
+  "max",
+];
+
+const SLUG_EFFORT_SUFFIX = /-(?:non-reasoning|minimal|low|medium|high|xhigh|max)$/;
+
+export interface ArtificialAnalysisRow {
+  readonly slug: string;
+  readonly name: string;
+  readonly creator: string | null;
+  readonly intelligenceIndex: number | null;
+  readonly outputTokensPerSecond: number | null;
+  readonly timeToFirstTokenSeconds: number | null;
+  readonly costPerTaskUsd: number | null;
+  readonly inputPricePerMillionTokens: number | null;
+  readonly outputPricePerMillionTokens: number | null;
+}
+
+export interface ArtificialAnalysisPage {
+  readonly rows: ReadonlyArray<ArtificialAnalysisRow>;
+  readonly hasMore: boolean;
+  readonly intelligenceIndexVersion: number | null;
+}
+
+function record(value: unknown): Readonly<Record<string, unknown>> {
+  return typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Record<string, unknown>)
+    : {};
+}
+
+function finite(value: unknown): number | null {
+  return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+function text(value: unknown): string | null {
+  return typeof value === "string" && value.trim().length > 0 ? value.trim() : null;
+}
+
+function parseRow(value: unknown): ArtificialAnalysisRow | null {
+  const row = record(value);
+  const slug = text(row.slug);
+  const name = text(row.name);
+  if (!slug || !name) return null;
+  const evaluations = record(row.evaluations);
+  // `performance` goes null from December 2026; v3 is its replacement.
+  const v3 = record(row.performance_v3);
+  const legacy = record(row.performance);
+  const pricing = record(row.pricing);
+  return {
+    slug,
+    name,
+    creator: text(record(row.model_creator).name),
+    intelligenceIndex: finite(evaluations.artificial_analysis_intelligence_index),
+    outputTokensPerSecond:
+      finite(v3.mean_output_tokens_per_second) ?? finite(legacy.median_output_tokens_per_second),
+    timeToFirstTokenSeconds:
+      finite(v3.mean_time_to_first_token_seconds) ??
+      finite(legacy.median_time_to_first_token_seconds),
+    costPerTaskUsd: finite(
+      record(record(row.artificial_analysis_intelligence_index_cost).cost_per_task).total_cost,
+    ),
+    inputPricePerMillionTokens: finite(pricing.price_1m_input_tokens),
+    outputPricePerMillionTokens: finite(pricing.price_1m_output_tokens),
+  };
+}
+
+/** One page of `/language/models/free`; rows it cannot read are skipped. */
+export function parseArtificialAnalysisPage(document: unknown): ArtificialAnalysisPage {
+  const body = record(document);
+  const data = Array.isArray(body.data) ? body.data : [];
+  return {
+    rows: data.flatMap((value) => {
+      const row = parseRow(value);
+      return row ? [row] : [];
+    }),
+    hasMore: record(body.pagination).has_more === true,
+    intelligenceIndexVersion: finite(body.intelligence_index_version),
+  };
+}
+
+/**
+ * Splits "Claude Opus 5.5 (High, Default Fallback)" into the model, its effort and what else the
+ * parentheses name. Fallback notes describe how the source ran the model, not a different model.
+ */
+export function splitVariantName(name: string): {
+  readonly base: string;
+  readonly effort: string | null;
+  readonly qualifiers: ReadonlyArray<string>;
+} {
+  const match = /^(.*?)\s*\(([^()]*)\)\s*$/.exec(name);
+  if (!match) return { base: name.trim(), effort: null, qualifiers: [] };
+  let effort: string | null = null;
+  const qualifiers: string[] = [];
+  for (const part of match[2]!.split(",")) {
+    const word = part.trim();
+    if (word.length === 0 || /fallback$/i.test(word)) continue;
+    const mapped = EFFORT_WORDS[word.toLowerCase()];
+    if (mapped !== undefined && effort === null) effort = mapped;
+    else if (mapped === undefined) qualifiers.push(word);
+  }
+  return { base: match[1]!.trim(), effort, qualifiers };
+}
+
+function effortRank(effort: string | null): number {
+  const index = effort === null ? -1 : EFFORT_ORDER.indexOf(effort);
+  return index === -1 ? EFFORT_ORDER.length : index;
+}
+
+/** Folds the per-effort rows into one entry per model, dropping models with nothing measured. */
+export function groupModelBenchmarks(
+  rows: ReadonlyArray<ArtificialAnalysisRow>,
+): ReadonlyArray<ModelBenchmark> {
+  const groups = new Map<
+    string,
+    { name: string; rows: Array<{ row: ArtificialAnalysisRow; effort: string | null }> }
+  >();
+  for (const row of rows) {
+    const { base, effort, qualifiers } = splitVariantName(row.name);
+    const name = qualifiers.length > 0 ? `${base} (${qualifiers.join(", ")})` : base;
+    const key = `${row.creator ?? ""}\u0000${name}`;
+    const group = groups.get(key) ?? { name, rows: [] };
+    group.rows.push({ row, effort });
+    groups.set(key, group);
+  }
+
+  const models: ModelBenchmark[] = [];
+  for (const group of groups.values()) {
+    const measured = group.rows.filter(
+      ({ row }) => row.intelligenceIndex !== null || row.outputTokensPerSecond !== null,
+    );
+    if (measured.length === 0) continue;
+    // The model's own slug is the bare one; every effort's slug shortens to it.
+    const slugCounts = new Map<string, number>();
+    for (const { row } of group.rows) {
+      const slug = row.slug.replace(SLUG_EFFORT_SUFFIX, "");
+      slugCounts.set(slug, (slugCounts.get(slug) ?? 0) + 1);
+    }
+    const slug = [...slugCounts.entries()].toSorted(
+      (a, b) => b[1] - a[1] || a[0].length - b[0].length,
+    )[0]![0];
+    const byEffort = new Map<string, ModelBenchmarkVariant>();
+    for (const { row, effort } of measured) {
+      const variant: ModelBenchmarkVariant = {
+        effort,
+        label: row.name,
+        intelligenceIndex: row.intelligenceIndex,
+        outputTokensPerSecond: row.outputTokensPerSecond,
+        timeToFirstTokenSeconds: row.timeToFirstTokenSeconds,
+        costPerTaskUsd: row.costPerTaskUsd,
+      };
+      const key = effort ?? "";
+      const existing = byEffort.get(key);
+      // Two rows for one effort: keep the one with a score.
+      if (!existing || (existing.intelligenceIndex === null && variant.intelligenceIndex !== null))
+        byEffort.set(key, variant);
+    }
+    const priced = group.rows.find(({ row }) => row.inputPricePerMillionTokens !== null)?.row;
+    models.push({
+      slug,
+      name: group.name,
+      creator: group.rows[0]!.row.creator,
+      inputPricePerMillionTokens: priced?.inputPricePerMillionTokens ?? null,
+      outputPricePerMillionTokens: priced?.outputPricePerMillionTokens ?? null,
+      variants: [...byEffort.values()].toSorted(
+        (a, b) => effortRank(a.effort) - effortRank(b.effort),
+      ),
+    });
+  }
+  return models.toSorted((a, b) => a.slug.localeCompare(b.slug));
+}
