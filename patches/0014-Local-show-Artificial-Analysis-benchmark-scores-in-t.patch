+  findModelBenchmark,
+  formatBenchmarkScore,
+  normalizeModelSlug,
+} from "./modelBenchmarks";
+
+const variant = (effort: string | null, intelligenceIndex: number | null) => ({
+  effort,
+  label: `Claude Opus 5.5 (${effort})`,
+  intelligenceIndex,
+  outputTokensPerSecond: 106.94,
+  timeToFirstTokenSeconds: 2,
+  costPerTaskUsd: 3.4647,
+});
+
+const opus: ModelBenchmark = {
+  slug: "claude-opus-5-5",
+  name: "Claude Opus 5.5",
+  creator: "Anthropic",
+  inputPricePerMillionTokens: 4,
+  outputPricePerMillionTokens: 20,
+  variants: [variant("low", 34.8), variant("high", 51.8), variant("max", 59.1)],
+};
+const sol: ModelBenchmark = { ...opus, slug: "gpt-5-6-sol", name: "GPT-5.6 Sol", variants: [] };
+const models = [opus, sol];
+
+describe("normalizeModelSlug", () => {
+  it("brings T3's ids to the source's slugs", () => {
+    expect(normalizeModelSlug("claude-opus-5-5")).toBe("claude-opus-5-5");
+    expect(normalizeModelSlug("gpt-5.6-sol")).toBe("gpt-5-6-sol");
+    expect(normalizeModelSlug("openai/GPT-6-Luna")).toBe("gpt-6-luna");
+    expect(normalizeModelSlug("claude-opus-5-5[1m]")).toBe("claude-opus-5-5");
+    expect(normalizeModelSlug("claude-opus-5-5-20260101")).toBe("claude-opus-5-5");
+    expect(normalizeModelSlug("claude-opus-5-5-latest")).toBe("claude-opus-5-5");
+  });
+});
+
+describe("findModelBenchmark", () => {
+  it("finds a model by any spelling of its id and nothing for an unknown one", () => {
+    expect(findModelBenchmark(models, "gpt-5.6-sol")).toBe(sol);
+    expect(findModelBenchmark(models, "anthropic/claude-opus-5-5")).toBe(opus);
+    expect(findModelBenchmark(models, "auto")).toBeNull();
+    expect(findModelBenchmark(null, "claude-opus-5-5")).toBeNull();
+  });
+});
+
+describe("benchmarkVariantForEffort", () => {
+  it("matches T3's effort ids and runs Ultrathink as max", () => {
+    expect(benchmarkVariantForEffort(opus, "high")?.intelligenceIndex).toBe(51.8);
+    expect(benchmarkVariantForEffort(opus, "ultrathink")?.intelligenceIndex).toBe(59.1);
+    expect(benchmarkVariantForEffort(opus, "medium")).toBeNull();
+    expect(benchmarkVariantForEffort(opus, null)).toBeNull();
+  });
+});
+
+describe("bestBenchmarkVariant and benchmarkScoreShare", () => {
+  it("picks the top score and sizes others against it", () => {
+    expect(bestBenchmarkVariant(opus)?.effort).toBe("max");
+    expect(bestBenchmarkVariant(sol)).toBeNull();
+    expect(benchmarkScoreShare(opus, opus.variants[1]!)).toBeCloseTo(51.8 / 59.1);
+    expect(benchmarkScoreShare(sol, null)).toBeNull();
+  });
+});
+
+describe("descriptions", () => {
+  it("formats scores, measurements, efforts and price", () => {
+    expect(formatBenchmarkScore(59.1)).toBe("59.1");
+    expect(formatBenchmarkScore(48)).toBe("48");
+    expect(formatBenchmarkScore(null)).toBeNull();
+    expect(describeBenchmarkVariant(opus.variants[1]!)).toEqual([
+      "Intelligence 51.8",
+      "107 tok/s",
+      "$3.46 per task",
+    ]);
+    expect(describeBenchmarkVariant({ ...variant("low", null), costPerTaskUsd: 0.0438 })).toEqual([
+      "No Intelligence Index yet",
+      "107 tok/s",
+      "$0.044 per task",
+    ]);
+    expect(describeBenchmarkEfforts(opus)).toBe("Low: 34.8 · High: 51.8 · Max: 59.1");
+    expect(describeBenchmarkPrice(opus)).toBe("$4 in / $20 out per 1M tokens");
+  });
+});
