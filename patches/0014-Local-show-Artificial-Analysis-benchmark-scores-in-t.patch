@@ -0,0 +1,63 @@
+import * as Schema from "effect/Schema";
+
+/**
+ * Benchmark results per model and reasoning effort, from Artificial Analysis
+ * (artificialanalysis.ai). Its data may only be shown with attribution.
+ */
+export const MODEL_BENCHMARKS_SOURCE_URL = "https://artificialanalysis.ai/";
+export const MODEL_BENCHMARKS_SOURCE_NAME = "Artificial Analysis";
+
+/** One measured configuration of a model, such as "Claude Opus 5.5 (High)". */
+export const ModelBenchmarkVariant = Schema.Struct({
+  /**
+   * The effort as T3 names its levels: `low`, `medium`, `high`, `xhigh`, `max`, `minimal` or
+   * `none` (non-reasoning). Null when the source names no effort.
+   */
+  effort: Schema.NullOr(Schema.String),
+  /** The source's own name for this configuration. */
+  label: Schema.String,
+  /** Artificial Analysis Intelligence Index; higher is better. Null when not evaluated. */
+  intelligenceIndex: Schema.NullOr(Schema.Number),
+  outputTokensPerSecond: Schema.NullOr(Schema.Number),
+  timeToFirstTokenSeconds: Schema.NullOr(Schema.Number),
+  /** What one task of the Intelligence Index cost to run, in USD. */
+  costPerTaskUsd: Schema.NullOr(Schema.Number),
+});
+export type ModelBenchmarkVariant = typeof ModelBenchmarkVariant.Type;
+
+/** A model with every effort the source measured it at. */
+export const ModelBenchmark = Schema.Struct({
+  /** The source's slug for the model at its default effort, such as `claude-opus-5-5`. */
+  slug: Schema.String,
+  /** The model name without the effort, such as "Claude Opus 5.5". */
+  name: Schema.String,
+  creator: Schema.NullOr(Schema.String),
+  inputPricePerMillionTokens: Schema.NullOr(Schema.Number),
+  outputPricePerMillionTokens: Schema.NullOr(Schema.Number),
+  variants: Schema.Array(ModelBenchmarkVariant),
+});
+export type ModelBenchmark = typeof ModelBenchmark.Type;
+
+export const ModelBenchmarksStatus = Schema.Literals([
+  /** Fetched within the last day. */
+  "fresh",
+  /** Older data kept because the last fetch failed. */
+  "cached",
+  /** No API key is set up. */
+  "unconfigured",
+  /** Nothing to show: the fetch failed and nothing was cached. */
+  "unavailable",
+]);
+export type ModelBenchmarksStatus = typeof ModelBenchmarksStatus.Type;
+
+export const ModelBenchmarks = Schema.Struct({
+  status: ModelBenchmarksStatus,
+  source: Schema.String,
+  fetchedAt: Schema.NullOr(Schema.String),
+  /** The Intelligence Index version the scores belong to, such as 5. */
+  intelligenceIndexVersion: Schema.NullOr(Schema.Number),
+  /** Why there is no fresh data, for a tooltip. */
+  message: Schema.NullOr(Schema.String),
+  models: Schema.Array(ModelBenchmark),
+});
+export type ModelBenchmarks = typeof ModelBenchmarks.Type;
