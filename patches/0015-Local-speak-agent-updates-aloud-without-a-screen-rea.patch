diff --git a/apps/web/src/lib/agentSpeech.test.ts b/apps/web/src/lib/agentSpeech.test.ts
new file mode 100644
index 0000000000..a67983a385
--- /dev/null
+++ b/apps/web/src/lib/agentSpeech.test.ts
@@ -0,0 +1,85 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { createAgentSpeaker, type AgentSpeechSynth } from "./agentSpeech";
+
+function fakeSynth(state: { speaking?: boolean; pending?: boolean } = {}) {
+  const spoken: string[] = [];
+  let cancelled = 0;
+  const synth: AgentSpeechSynth = {
+    speaking: state.speaking ?? false,
+    pending: state.pending ?? false,
+    speak: (text) => spoken.push(text),
+    cancel: () => {
+      cancelled += 1;
+    },
+  };
+  return { synth, spoken, cancelled: () => cancelled };
+}
+
+describe("createAgentSpeaker", () => {
+  it("says nothing while the setting is off", () => {
+    const { synth, spoken } = fakeSynth();
+    createAgentSpeaker(
+      () => synth,
+      () => false,
+    ).speak("Working", "status");
+    expect(spoken).toEqual([]);
+  });
+
+  it("speaks status, messages and steps when idle", () => {
+    const { synth, spoken } = fakeSynth();
+    const speaker = createAgentSpeaker(
+      () => synth,
+      () => true,
+    );
+    speaker.speak("Working", "status");
+    speaker.speak("Looking at the tests.", "message");
+    speaker.speak("Running pnpm test", "step");
+    expect(spoken).toEqual(["Working", "Looking at the tests.", "Running pnpm test"]);
+  });
+
+  it("queues status and messages but drops a step while still speaking", () => {
+    const { synth, spoken } = fakeSynth({ speaking: true });
+    const speaker = createAgentSpeaker(
+      () => synth,
+      () => true,
+    );
+    speaker.speak("Running pnpm test", "step");
+    speaker.speak("Needs approval", "status");
+    speaker.speak("Done.", "message");
+    expect(spoken).toEqual(["Needs approval", "Done."]);
+  });
+
+  it("drops a step while something is queued", () => {
+    const { synth, spoken } = fakeSynth({ pending: true });
+    createAgentSpeaker(
+      () => synth,
+      () => true,
+    ).speak("Reading a file", "step");
+    expect(spoken).toEqual([]);
+  });
+
+  it("skips blank text and works without speech support", () => {
+    const { synth, spoken } = fakeSynth();
+    createAgentSpeaker(
+      () => synth,
+      () => true,
+    ).speak("    ", "message");
+    expect(spoken).toEqual([]);
+    expect(() =>
+      createAgentSpeaker(
+        () => null,
+        () => true,
+      ).speak("Done", "status"),
+    ).not.toThrow();
+  });
+
+  it("stop cancels speech", () => {
+    const { synth, cancelled } = fakeSynth();
+    createAgentSpeaker(
+      () => synth,
+      () => true,
+    ).stop();
+    expect(cancelled()).toBe(1);
+  });
+});
diff --git a/apps/web/src/lib/agentSpeech.ts b/apps/web/src/lib/agentSpeech.ts
new file mode 100644
index 0000000000..c9465e9f4b
--- /dev/null
+++ b/apps/web/src/lib/agentSpeech.ts
@@ -0,0 +1,71 @@
+/**
+ * Reads agent updates aloud with the system voice, for people who want to hear
+ * what an agent is doing without running a screen reader. It speaks the same
+ * text the screen reader live regions get.
+ */
+
+/** What an update says: a status (turn started, needs you, done), a message, or a step. */
+export type AgentSpeechKind = "status" | "message" | "step";
+
+export interface AgentSpeechSynth {
+  readonly speaking: boolean;
+  readonly pending: boolean;
+  speak(text: string): void;
+  cancel(): void;
+}
+
+export interface AgentSpeaker {
+  speak(text: string, kind: AgentSpeechKind): void;
+  stop(): void;
+}
+
+/**
+ * Status and messages queue behind what is being said. A step is dropped while
+ * anything is still being said, since a newer step soon replaces it.
+ */
+export function createAgentSpeaker(
+  synth: () => AgentSpeechSynth | null,
+  enabled: () => boolean,
+): AgentSpeaker {
+  return {
+    speak(text, kind) {
+      const trimmed = text.trim();
+      if (trimmed.length === 0 || !enabled()) return;
+      const target = synth();
+      if (target === null) return;
+      if (kind === "step" && (target.speaking || target.pending)) return;
+      target.speak(trimmed);
+    },
+    stop() {
+      synth()?.cancel();
+    },
+  };
+}
+
+function browserSynth(): AgentSpeechSynth | null {
+  if (typeof window === "undefined" || !("speechSynthesis" in window)) return null;
+  const synthesis = window.speechSynthesis;
+  return {
+    get speaking() {
+      return synthesis.speaking;
+    },
+    get pending() {
+      return synthesis.pending;
+    },
+    speak(text) {
+      synthesis.speak(new SpeechSynthesisUtterance(text));
+    },
+    cancel() {
+      synthesis.cancel();
+    },
+  };
+}
+
+let isEnabled: () => boolean = () => false;
+
+/** Points the shared speaker at the setting; called once at app start. */
+export function setAgentSpeechEnabled(read: () => boolean) {
+  isEnabled = read;
+}
+
+export const agentSpeaker = createAgentSpeaker(browserSynth, () => isEnabled());
