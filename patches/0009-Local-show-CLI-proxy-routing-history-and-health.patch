diff --git a/apps/web/src/components/usage/proxyObservability.ts b/apps/web/src/components/usage/proxyObservability.ts
new file mode 100644
index 00000000000..933eed342f9
--- /dev/null
+++ b/apps/web/src/components/usage/proxyObservability.ts
@@ -0,0 +1,103 @@
+import type {
+  ServerProviderUsageWindow,
+  UsageLimitSourceAdaptiveWindow,
+  UsageLimitSourceHistory,
+  UsageLimitSourceRoutingCandidate,
+} from "@t3tools/contracts";
+import type { LimitPresentations } from "@t3tools/shared/usageLimits";
+
+type HistoryPoints = UsageLimitSourceHistory[number]["points"];
+
+export interface ProxyAccountObservability {
+  readonly history: HistoryPoints;
+  readonly candidate: UsageLimitSourceRoutingCandidate | undefined;
+  /** The proxy would give this account the next new chat. */
+  readonly isNext: boolean;
+}
+
+/** Keyed like the pooled Usage page's accounts: `<source id>:<account id>`. */
+export function collectProxyObservability(
+  presentations: LimitPresentations,
+): ReadonlyMap<string, ProxyAccountObservability> {
+  const result = new Map<string, ProxyAccountObservability>();
+  for (const presentation of presentations.values()) {
+    for (const source of presentation.serverConfig?.usageLimitSources ?? []) {
+      const history = new Map(source.history?.map((entry) => [entry.accountId, entry.points]));
+      const candidates = new Map<string, UsageLimitSourceRoutingCandidate>();
+      const next = new Set<string>();
+      for (const queue of source.routing?.next ?? []) {
+        const chosen = queue.candidates.find((candidate) => !candidate.unavailable);
+        if (chosen) next.add(chosen.accountId);
+        for (const candidate of queue.candidates) candidates.set(candidate.accountId, candidate);
+      }
+      for (const account of source.accounts) {
+        const points = history.get(account.id);
+        const candidate = candidates.get(account.id);
+        if (!points && !candidate) continue;
+        const observed = {
+          history: points ?? [],
+          candidate,
+          isNext: next.has(account.id),
+        };
+        result.set(`${source.id}:${account.id}`, observed);
+        if (account.workspaceId) {
+          result.set(`${source.id}:${account.id}:${account.workspaceId}`, observed);
+        }
+      }
+    }
+  }
+  return result;
+}
+
+/** The proxy samples its account-wide 5h and weekly windows; model-scoped rows have no history. */
+function historyField(window: ServerProviderUsageWindow): "short" | "long" | null {
+  if (window.kind === "session") return "short";
+  if (window.kind !== "weekly") return null;
+  return window.id === "seven_day" || window.id === "secondary" ? "long" : null;
+}
+
+export function windowHistory(
+  observed: ProxyAccountObservability | undefined,
+  window: ServerProviderUsageWindow,
+): ReadonlyArray<{ readonly at: number; readonly used: number }> {
+  const field = observed ? historyField(window) : null;
+  if (!observed || !field) return [];
+  return observed.history.flatMap((point) => {
+    const used = point[field];
+    return used === undefined ? [] : [{ at: point.at * 1000, used }];
+  });
+}
+
+export function windowAdaptive(
+  observed: ProxyAccountObservability | undefined,
+  window: ServerProviderUsageWindow,
+): UsageLimitSourceAdaptiveWindow | undefined {
+  const field = historyField(window);
+  if (!field) return undefined;
+  return observed?.candidate?.adaptive?.[field];
+}
+
+/** What a proxy fork reports as needing attention, phrased for the Usage page notices. */
+export function collectProxyHealthNotices(presentations: LimitPresentations): readonly string[] {
+  const notices: string[] = [];
+  const labelEnvironment = presentations.size > 1;
+  for (const presentation of presentations.values()) {
+    for (const source of presentation.serverConfig?.usageLimitSources ?? []) {
+      const health = source.health;
+      if (!health) continue;
+      const label = labelEnvironment
+        ? `${presentation.entry.target.label} · ${source.label}`
+        : source.label;
+      for (const run of health.failedRuns) {
+        const step = run.step ? ` at ${run.step}` : "";
+        const detail = run.detail ? `: ${run.detail.replace(/[.\s]+$/, "")}.` : ".";
+        const pending = health.updateAvailable ? ` Pending: ${health.updateAvailable}.` : "";
+        notices.push(`${label}: the ${run.component} updater failed${step}${detail}${pending}`);
+      }
+      for (const service of health.stoppedServices) {
+        notices.push(`${label}: ${service} is not running.`);
+      }
+    }
+  }
+  return notices;
+}
