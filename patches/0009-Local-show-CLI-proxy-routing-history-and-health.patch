diff --git a/apps/server/src/usage/cliproxyObservability.ts b/apps/server/src/usage/cliproxyObservability.ts
new file mode 100644
index 00000000000..b98a2b1cb2c
--- /dev/null
+++ b/apps/server/src/usage/cliproxyObservability.ts
@@ -0,0 +1,241 @@
+/**
+ * Reads the observability endpoints a CLIProxyAPI fork serves beside the stock management API:
+ * per-chat routing, the queue for the next new chat, quota history and the fork's own health.
+ * Stock proxies answer 404, so every reader here is optional and tolerant of missing fields.
+ * Chat titles hold the first prompt and are never copied.
+ */
+import {
+  ProviderDriverKind,
+  type UsageLimitSourceAdaptiveWindow,
+  type UsageLimitSourceHealth,
+  type UsageLimitSourceHistory,
+  type UsageLimitSourceRouting,
+  type UsageLimitSourceRoutingCandidate,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+
+const HISTORY_SECONDS = 7 * 24 * 3600;
+const HISTORY_BUCKET_SECONDS = 3600;
+const MAX_FAILED_RUN_DETAIL = 240;
+
+type Json = Record<string, unknown>;
+
+const record = (value: unknown): Json | undefined =>
+  typeof value === "object" && value !== null && !Array.isArray(value)
+    ? (value as Json)
+    : undefined;
+const list = (value: unknown): readonly unknown[] => (Array.isArray(value) ? value : []);
+const text = (value: unknown): string | undefined =>
+  typeof value === "string" && value.trim() !== "" ? value : undefined;
+const number = (value: unknown): number | undefined =>
+  typeof value === "number" && Number.isFinite(value) ? value : undefined;
+const bool = (value: unknown): boolean => value === true;
+
+/** Go encodes an unset time as year 1; drop it and anything unparseable. */
+function isoTime(value: unknown): string | undefined {
+  const raw = text(value);
+  if (!raw || raw.startsWith("0001-")) return undefined;
+  const ms = Date.parse(raw);
+  return Number.isFinite(ms) ? DateTime.formatIso(DateTime.makeUnsafe(ms)) : undefined;
+}
+
+function driverForProvider(provider: string | undefined): ProviderDriverKind | undefined {
+  if (provider === "claude") return ProviderDriverKind.make("claudeAgent");
+  if (provider === "codex") return ProviderDriverKind.make("codex");
+  return undefined;
+}
+
+function adaptiveWindow(value: unknown): UsageLimitSourceAdaptiveWindow | undefined {
+  const window = record(value);
+  if (!window) return undefined;
+  const used = number(window.used);
+  const reserve = number(window.reserve);
+  const spare = number(window.spare);
+  const forecast = number(window.forecast);
+  if (used === undefined || reserve === undefined || spare === undefined) return undefined;
+  const reset = isoTime(window.reset);
+  return {
+    used,
+    reserve,
+    spare,
+    forecast: forecast ?? 0,
+    learning: bool(window.learning),
+    inactive: bool(window.inactive),
+    ...(reset ? { reset } : {}),
+  };
+}
+
+function routingCandidate(value: unknown): UsageLimitSourceRoutingCandidate | undefined {
+  const candidate = record(value);
+  const accountId = text(candidate?.auth);
+  if (!candidate || !accountId) return undefined;
+  const adaptive = record(candidate.adaptive);
+  const retryAfter = isoTime(candidate.retry_after);
+  const short = adaptiveWindow(adaptive?.short);
+  const long = adaptiveWindow(adaptive?.long);
+  return {
+    accountId,
+    unavailable: bool(candidate.unavailable),
+    saturated: bool(candidate.saturated),
+    ...(retryAfter ? { retryAfter } : {}),
+    ...(adaptive
+      ? {
+          adaptive: {
+            reason: text(adaptive.reason) ?? "",
+            home: bool(adaptive.home),
+            fresh: bool(adaptive.fresh),
+            eligible: bool(adaptive.eligible),
+            draining: bool(adaptive.draining),
+            ...(short ? { short } : {}),
+            ...(long ? { long } : {}),
+          },
+        }
+      : {}),
+  };
+}
+
+export function toRouting(raw: unknown): UsageLimitSourceRouting | undefined {
+  const body = record(raw);
+  if (!body || !Array.isArray(body.sessions)) return undefined;
+  const sessions = list(body.sessions).flatMap((value) => {
+    const session = record(value);
+    const id = text(session?.id);
+    const accountId = text(session?.auth);
+    const driver = driverForProvider(text(session?.provider));
+    const firstSeen = isoTime(session?.first_seen);
+    const lastSeen = isoTime(session?.last_seen);
+    if (!session || !id || !accountId || !driver || !firstSeen || !lastSeen) return [];
+    // Threads map to main sessions only; subagents and one-off calls would only add weight.
+    const sessionAgent = text(session.agent);
+    if (sessionAgent !== undefined && sessionAgent !== "main") return [];
+    const switches = list(session.switches).flatMap((entry) => {
+      const change = record(entry);
+      const at = isoTime(change?.at);
+      const from = text(change?.from);
+      const to = text(change?.to);
+      return at && from && to ? [{ at, from, to }] : [];
+    });
+    const client = text(session.client);
+    const agent = text(session.agent);
+    const parent = text(session.parent);
+    return [
+      {
+        id,
+        driver,
+        accountId,
+        model: text(session.model) ?? "",
+        requests: Math.max(0, Math.trunc(number(session.requests) ?? 0)),
+        firstSeen,
+        lastSeen,
+        switches,
+        ...(client ? { client } : {}),
+        ...(agent ? { agent } : {}),
+        ...(parent ? { parent } : {}),
+      },
+    ];
+  });
+  const nextByProvider = record(body.next) ?? {};
+  const next = Object.entries(nextByProvider).flatMap(([provider, candidates]) => {
+    const driver = driverForProvider(provider);
+    if (!driver) return [];
+    return [{ driver, candidates: list(candidates).flatMap((c) => routingCandidate(c) ?? []) }];
+  });
+  return { sessions, next };
+}
+
+/** One point per account and hour for the last week, keeping the hour's latest reading. */
+export function toHistory(raw: unknown, nowSeconds: number): UsageLimitSourceHistory | undefined {
+  const body = record(raw);
+  if (!body || !Array.isArray(body.points)) return undefined;
+  const since = nowSeconds - HISTORY_SECONDS;
+  const byAccount = new Map<string, Map<number, { at: number; short?: number; long?: number }>>();
+  for (const value of body.points) {
+    const point = record(value);
+    const accountId = text(point?.auth);
+    const at = number(point?.t);
+    if (!point || !accountId || at === undefined || at < since || at > nowSeconds + 60) continue;
+    const short = number(point.short_used);
+    const long = number(point.long_used);
+    if (short === undefined && long === undefined) continue;
+    const bucket = Math.floor(at / HISTORY_BUCKET_SECONDS);
+    const buckets = byAccount.get(accountId) ?? new Map();
+    byAccount.set(accountId, buckets);
+    const previous = buckets.get(bucket);
+    if (previous && previous.at > at) continue;
+    // A reading may omit one window; keep the hour's other value rather than dropping it.
+    buckets.set(bucket, {
+      at: Math.trunc(at),
+      ...(short !== undefined
+        ? { short: percent(short) }
+        : previous?.short !== undefined
+          ? { short: previous.short }
+          : {}),
+      ...(long !== undefined
+        ? { long: percent(long) }
+        : previous?.long !== undefined
+          ? { long: previous.long }
+          : {}),
+    });
+  }
+  return [...byAccount].map(([accountId, buckets]) => ({
+    accountId,
+    points: [...buckets.values()].sort((left, right) => left.at - right.at),
+  }));
+}
+
+function percent(share: number): number {
+  return Math.round(Math.max(0, Math.min(1, share)) * 1000) / 10;
+}
+
+/** Only what needs attention: the latest run per component when it failed, and stopped jobs. */
+export function toHealth(raw: unknown): UsageLimitSourceHealth | undefined {
+  const body = record(raw);
+  const status = record(body?.status);
+  if (!body || !status) return undefined;
+  const version = text(record(body.running)?.version);
+  const updates = list(status.repos).flatMap((value) => {
+    const repo = record(value);
+    const name = text(repo?.name);
+    const base = text(repo?.base_tag);
+    const latest = text(repo?.latest_tag);
+    return name && base && latest && base !== latest ? [`${name} ${latest}`] : [];
+  });
+  const latestRun = new Map<string, Json>();
+  for (const value of list(status.runs)) {
+    const run = record(value);
+    const component = text(run?.component);
+    const at = isoTime(run?.at);
+    if (!run || !component || !at) continue;
+    const previous = latestRun.get(component);
+    if (!previous || Date.parse(at) > Date.parse(isoTime(previous.at)!)) {
+      latestRun.set(component, run);
+    }
+  }
+  const failedRuns = [...latestRun].flatMap(([component, run]) => {
+    if (run.outcome !== "failed") return [];
+    const step = text(run.step);
+    const detail = text(run.detail)?.slice(0, MAX_FAILED_RUN_DETAIL);
+    return [
+      {
+        at: isoTime(run.at)!,
+        component,
+        ...(step ? { step } : {}),
+        ...(detail ? { detail } : {}),
+      },
+    ];
+  });
+  const stoppedServices = list(status.services).flatMap((value) => {
+    const service = record(value);
+    const label = text(service?.label);
+    const lastExit = number(service?.last_exit);
+    return label && number(service?.pid) === undefined && lastExit !== undefined && lastExit !== 0
+      ? [label]
+      : [];
+  });
+  return {
+    failedRuns,
+    stoppedServices,
+    ...(version ? { version } : {}),
+    ...(updates.length > 0 ? { updateAvailable: updates.join(", ") } : {}),
+  };
+}
