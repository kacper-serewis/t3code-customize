new file mode 100644
index 00000000000..230ea8e93ee
--- /dev/null
+++ b/apps/web/src/lib/proxyRouting.ts
@@ -0,0 +1,113 @@
+import type {
+  ProviderDriverKind,
+  UsageLimitSourceAccount,
+  UsageLimitSourceAdaptiveWindow,
+  UsageLimitSourceRoutingCandidate,
+  UsageLimitSourceRoutingSession,
+  UsageLimitSourceSnapshot,
+  UsageLimitSourceSnapshots,
+} from "@t3tools/contracts";
+
+/** A switch this recent still costs the chat its prompt cache on the next turn or so. */
+export const RECENT_SWITCH_MS = 30 * 60_000;
+
+export interface ProxyAccountRef {
+  readonly id: string;
+  readonly label: string;
+  readonly email: string | undefined;
+  readonly account: UsageLimitSourceAccount | undefined;
+}
+
+export interface ProxySessionRoute {
+  readonly source: UsageLimitSourceSnapshot;
+  readonly session: UsageLimitSourceRoutingSession;
+  readonly account: ProxyAccountRef;
+  readonly lastSwitch: { readonly at: number; readonly from: ProxyAccountRef } | null;
+}
+
+export interface ProxyNextRoute {
+  readonly source: UsageLimitSourceSnapshot;
+  readonly candidate: UsageLimitSourceRoutingCandidate;
+  readonly account: ProxyAccountRef;
+}
+
+/** The proxy keys chats by client and the native session or thread id T3 already stores. */
+export function proxySessionId(driver: ProviderDriverKind, nativeSessionId: string): string {
+  return `${driver === "codex" ? "codex" : "claude"}:${nativeSessionId}`;
+}
+
+export function proxyAccountRef(source: UsageLimitSourceSnapshot, id: string): ProxyAccountRef {
+  const account = source.accounts.find((candidate) => candidate.id === id);
+  const email = account?.email ?? (id.includes("@") ? id.replace(/\.json$/, "") : undefined);
+  const label = email?.split("@")[0] || id.replace(/\.json$/, "");
+  return { id, label, email, account };
+}
+
+export function findProxySession(
+  sources: UsageLimitSourceSnapshots,
+  driver: ProviderDriverKind,
+  nativeSessionId: string | null,
+): ProxySessionRoute | null {
+  if (!nativeSessionId) return null;
+  const id = proxySessionId(driver, nativeSessionId);
+  for (const source of sources) {
+    const session = source.routing?.sessions.find((candidate) => candidate.id === id);
+    if (!session) continue;
+    const switched = session.switches.at(-1);
+    return {
+      source,
+      session,
+      account: proxyAccountRef(source, session.accountId),
+      lastSwitch: switched
+        ? { at: Date.parse(switched.at), from: proxyAccountRef(source, switched.from) }
+        : null,
+    };
+  }
+  return null;
+}
+
+/** The account the proxy would give a new chat now: the first in its queue not cooling down. */
+export function nextProxyRoute(
+  sources: UsageLimitSourceSnapshots,
+  driver: ProviderDriverKind,
+): ProxyNextRoute | null {
+  for (const source of sources) {
+    const queue = source.routing?.next.find((entry) => entry.driver === driver);
+    const candidate = queue?.candidates.find((entry) => !entry.unavailable);
+    if (queue && candidate) {
+      return { source, candidate, account: proxyAccountRef(source, candidate.accountId) };
+    }
+  }
+  return null;
+}
+
+export function isRecentSwitch(route: ProxySessionRoute, now: number): boolean {
+  return route.lastSwitch !== null && now - route.lastSwitch.at < RECENT_SWITCH_MS;
+}
+
+const REASON_LABELS: Record<string, string> = {
+  home: "Home account, with spare capacity",
+  surplus_selected: "Borrowing spare capacity from another account",
+  surplus: "Has spare capacity",
+  fallback: "Last resort: no account has safe spare capacity",
+  reserved: "Its spare capacity is held back for forecast demand",
+  stale: "Usage data is too old to count on",
+  exhausted: "Out of quota",
+  cooldown: "Cooling down after a rate limit",
+};
+
+export function describeAdaptiveReason(reason: string): string {
+  return REASON_LABELS[reason] ?? (reason ? reason.replaceAll("-", " ") : "Next in the queue");
+}
+
+const share = (value: number) => `${Math.round(Math.max(0, value) * 100)}%`;
+
+/** "62% spare after a 30% reserve", the way the proxy weighs a window for new chats. */
+export function describeAdaptiveWindow(
+  label: string,
+  window: UsageLimitSourceAdaptiveWindow | undefined,
+): string | null {
+  if (!window || window.inactive) return null;
+  const learning = window.learning ? " (still learning usage)" : "";
+  return `${label}: ${share(window.spare)} spare after a ${share(window.reserve)} reserve, ${share(window.used)} used${learning}`;
+}
