@@ -0,0 +1,37 @@
+import type { ProviderDriverKind, UsageLimitSourceSnapshots } from "@t3tools/contracts";
+import { formatDuration } from "@t3tools/shared/usageLimits";
+import { ArrowRightLeftIcon } from "lucide-react";
+import { useState } from "react";
+
+import { useNowMinute } from "../../hooks/useNowMinute";
+import { findProxySession, isRecentSwitch } from "../../lib/proxyRouting";
+import type { ComposerBannerStackItem } from "./ComposerBannerStack";
+
+/**
+ * A notice above the composer when the CLI proxy recently moved this chat to another account,
+ * since the move costs the chat its prompt cache once. Dismissing it hides that one switch.
+ */
+export function useProxySwitchBanner(input: {
+  readonly sources: UsageLimitSourceSnapshots;
+  readonly driver: ProviderDriverKind | null;
+  readonly nativeSessionId: string | null;
+}): ComposerBannerStackItem | null {
+  const nowMinute = useNowMinute();
+  const [dismissed, setDismissed] = useState<string | null>(null);
+  const now = Date.parse(`${nowMinute}:00Z`);
+  const route = input.driver
+    ? findProxySession(input.sources, input.driver, input.nativeSessionId)
+    : null;
+  if (!route || !route.lastSwitch || !isRecentSwitch(route, now)) return null;
+  const key = `${route.session.id}:${route.lastSwitch.at}`;
+  if (dismissed === key) return null;
+  return {
+    id: `proxy-switch:${key}`,
+    variant: "info",
+    icon: <ArrowRightLeftIcon />,
+    title: `${route.source.label} moved this chat from ${route.lastSwitch.from.label} to ${route.account.label}`,
+    description: `${formatDuration(Math.max(0, now - route.lastSwitch.at))} ago. The prompt cache is rebuilt once on the new account.`,
+    dismissLabel: "Dismiss account switch notice",
+    onDismiss: () => setDismissed(key),
+  };
+}
