diff --git a/apps/web/src/components/usage/UsageSparkline.tsx b/apps/web/src/components/usage/UsageSparkline.tsx
new file mode 100644
index 00000000000..d013a41776d
--- /dev/null
+++ b/apps/web/src/components/usage/UsageSparkline.tsx
@@ -0,0 +1,155 @@
+import { useState } from "react";
+
+import { cn } from "~/lib/utils";
+
+const WEEK_MS = 7 * 24 * 60 * 60_000;
+
+export interface SparklinePoint {
+  readonly at: number;
+  /** Percentage of the window used, 0-100; the line plots what is left. */
+  readonly used: number;
+}
+
+function geometry(
+  points: readonly SparklinePoint[],
+  now: number,
+  width: number,
+  height: number,
+  inset: number,
+) {
+  const start = now - WEEK_MS;
+  const x = (at: number) => inset + ((at - start) / WEEK_MS) * (width - inset * 2);
+  const y = (left: number) => inset + (1 - left / 100) * (height - inset * 2);
+  const visible = points.filter((point) => point.at >= start && point.at <= now);
+  const path = visible
+    .map((point, index) => {
+      const left = Math.max(0, Math.min(100, 100 - point.used));
+      return `${index === 0 ? "M" : "L"}${x(point.at).toFixed(1)},${y(left).toFixed(1)}`;
+    })
+    .join(" ");
+  return { visible, path, x, y };
+}
+
+/** A week of one window's room left, small enough to sit in a legend row. */
+export function UsageSparklineMini({
+  points,
+  now,
+  className,
+}: {
+  readonly points: readonly SparklinePoint[];
+  readonly now: number;
+  readonly className?: string;
+}) {
+  const width = 48;
+  const height = 14;
+  const { visible, path } = geometry(points, now, width, height, 1.5);
+  if (visible.length < 2) return null;
+  return (
+    <svg
+      aria-hidden
+      width={width}
+      height={height}
+      viewBox={`0 0 ${width} ${height}`}
+      className={cn("shrink-0 text-muted-foreground", className)}
+    >
+      <path d={path} fill="none" stroke="currentColor" strokeWidth={1.5} strokeLinejoin="round" />
+    </svg>
+  );
+}
+
+/**
+ * The same week at popover size, with the proxy's reserve as a dashed line: once the room left
+ * falls to it, the proxy stops giving this account new chats. Hovering reads off one hour.
+ */
+export function UsageSparkline({
+  points,
+  now,
+  reservePercent,
+  formatAt,
+}: {
+  readonly points: readonly SparklinePoint[];
+  readonly now: number;
+  readonly reservePercent?: number | undefined;
+  readonly formatAt: (at: number) => string;
+}) {
+  const width = 264;
+  const height = 48;
+  const { visible, path, x, y } = geometry(points, now, width, height, 3);
+  const [hovered, setHovered] = useState<SparklinePoint | null>(null);
+  if (visible.length < 2) return null;
+  const last = visible.at(-1)!;
+  const shown = hovered ?? last;
+  const shownLeft = Math.round(100 - shown.used);
+  return (
+    <div className="flex flex-col gap-1">
+      <span className="flex justify-between text-2xs text-muted-foreground tabular-nums">
+        <span>{hovered ? formatAt(hovered.at) : "Last 7 days"}</span>
+        <span className="font-medium text-foreground">{shownLeft}% left</span>
+      </span>
+      <svg
+        role="img"
+        aria-label={`Room left over the last 7 days, now ${Math.round(100 - last.used)}%`}
+        width={width}
+        height={height}
+        viewBox={`0 0 ${width} ${height}`}
+        className="max-w-full text-foreground/70"
+        onPointerMove={(event) => {
+          const box = event.currentTarget.getBoundingClientRect();
+          const at = now - WEEK_MS + ((event.clientX - box.left) / box.width) * WEEK_MS;
+          let nearest = visible[0]!;
+          for (const point of visible) {
+            if (Math.abs(point.at - at) < Math.abs(nearest.at - at)) nearest = point;
+          }
+          setHovered(nearest);
+        }}
+        onPointerLeave={() => setHovered(null)}
+      >
+        <line
+          x1={3}
+          x2={width - 3}
+          y1={height - 3}
+          y2={height - 3}
+          className="stroke-border"
+          strokeWidth={1}
+        />
+        {reservePercent !== undefined && reservePercent > 0 && reservePercent < 100 ? (
+          <line
+            x1={3}
+            x2={width - 3}
+            y1={y(reservePercent)}
+            y2={y(reservePercent)}
+            className="stroke-muted-foreground/60"
+            strokeWidth={1}
+            strokeDasharray="3 3"
+          />
+        ) : null}
+        <path d={path} fill="none" stroke="currentColor" strokeWidth={2} strokeLinejoin="round" />
+        {hovered ? (
+          <>
+            <line
+              x1={x(hovered.at)}
+              x2={x(hovered.at)}
+              y1={3}
+              y2={height - 3}
+              className="stroke-muted-foreground/50"
+              strokeWidth={1}
+            />
+            <circle
+              cx={x(hovered.at)}
+              cy={y(100 - hovered.used)}
+              r={4}
+              fill="currentColor"
+              className="stroke-popover"
+              strokeWidth={2}
+            />
+          </>
+        ) : null}
+      </svg>
+      {reservePercent !== undefined && reservePercent > 0 ? (
+        <span className="text-2xs text-muted-foreground">
+          Dashed: the proxy's reserve ({Math.round(reservePercent)}%)
+        </span>
+      ) : null}
+    </div>
+  );
+}
