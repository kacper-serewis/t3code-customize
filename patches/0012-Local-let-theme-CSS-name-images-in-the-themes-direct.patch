+/** `url(theme-file:NAME)` names an image in the themes directory. The server inlines it. */
+const THEME_FILE_URL =
+  /url\([ \t\n\f\r]*(["']?)theme-file:([A-Za-z0-9][A-Za-z0-9._-]{0,63})\1[ \t\n\f\r]*\)/g;
+
+const THEME_FILE_MEDIA_TYPES: Readonly<Record<string, string>> = {
+  avif: "image/avif",
+  webp: "image/webp",
+  png: "image/png",
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  gif: "image/gif",
+};
+
+/** The media type a theme file is served as, or undefined when it is not an image. */
+export function themeFileMediaType(name: string): string | undefined {
+  const dot = name.lastIndexOf(".");
+  return dot < 0 ? undefined : THEME_FILE_MEDIA_TYPES[name.slice(dot + 1).toLowerCase()];
+}
+
+/**
+ * Replaces each `url(theme-file:NAME)` with the data: address `load` gives for that name.
+ * A name it gives nothing for becomes an empty data: address, so no client fetches it.
+ */
+export function inlineThemeFiles(
+  css: string,
+  load: (name: string) => string | undefined,
+): string {
+  return css.replace(
+    THEME_FILE_URL,
+    (_match, _quote: string, name: string) => `url("${load(name) ?? "data:,"}")`,
+  );
+}
