       `${soonest.weekly.window.label.toLowerCase()} allowance is unused and ${resets}. Use it first.`,
   );
 }
+
+export interface SubscriptionStanding {
+  readonly instanceId: ProviderInstanceId;
+  readonly providerName: string;
+  readonly current: boolean;
+  readonly state: "ok" | "running-out" | "unknown" | "unavailable";
+  /** Highest used or projected percent among the model's windows; null when unknown. */
+  readonly worstPercent: number | null;
+}
+
+/** Every subscription that offers this model, current first, for the limits popover. */
+export function subscriptionStandings(input: {
+  readonly instanceId: ProviderInstanceId | null;
+  readonly model: string | null;
+  readonly providers: ReadonlyArray<ServerProvider>;
+  readonly nowMs: number;
+}): ReadonlyArray<SubscriptionStanding> {
+  const { instanceId, model, providers, nowMs } = input;
+  if (instanceId === null || model === null) return [];
+  return providers
+    .flatMap((provider) => {
+      const current = provider.instanceId === instanceId;
+      const target = current ? { slug: model } : modelOn(provider, model);
+      if (!target) return [];
+      const assessment = assessSubscription(provider, target.slug, nowMs);
+      const state: SubscriptionStanding["state"] =
+        !current && !canRun(provider)
+          ? "unavailable"
+          : assessment === null
+            ? "unknown"
+            : assessment.runningOut
+              ? "running-out"
+              : "ok";
+      return [
+        {
+          instanceId: provider.instanceId,
+          providerName: providerName(provider),
+          current,
+          state,
+          worstPercent: assessment?.worstPercent ?? null,
+        },
+      ];
+    })
+    .toSorted((a, b) => Number(b.current) - Number(a.current));
+}
