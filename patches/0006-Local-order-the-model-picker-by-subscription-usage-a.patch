+  return (
+    <span className="flex shrink-0 items-center gap-1.5 text-xs font-normal leading-snug tabular-nums text-muted-foreground/70">
+      {usage.windows.map((window) => (
+        <span
+          key={window.shortLabel}
+          className={cn(window.runningOut && "text-warning", window.dimmed && "opacity-60")}
+        >
+          {window.shortLabel} {window.percentText}
+        </span>
+      ))}
+      {tag ? <span className={cn("font-medium", tag.className)}>{tag.label}</span> : null}
+    </span>
+  );
+}
 
