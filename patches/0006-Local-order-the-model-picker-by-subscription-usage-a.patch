diff --git a/apps/web/src/components/chat/ModelPickerUsage.logic.test.ts b/apps/web/src/components/chat/ModelPickerUsage.logic.test.ts
new file mode 100644
index 000000000..3bf776026
--- /dev/null
+++ b/apps/web/src/components/chat/ModelPickerUsage.logic.test.ts
@@ -0,0 +1,101 @@
+import {
+  ProviderInstanceId,
+  type ServerProvider,
+  type ServerProviderUsageWindow,
+} from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  formatPickerUsageWindows,
+  pickerSubscriptionUsage,
+  pickerUsageByInstance,
+  sortByPickerUsage,
+} from "./ModelPickerUsage.logic";
+
+const nowMs = Date.parse("2026-10-11T12:00:00Z");
+const iso = (offsetMs: number) => new Date(nowMs + offsetMs).toISOString();
+const HOUR = 60 * 60_000;
+
+const window = (
+  kind: "session" | "weekly",
+  usedPercent: number,
+  resetInHours: number,
+): ServerProviderUsageWindow => ({
+  id: kind === "session" ? "five_hour" : "seven_day",
+  kind,
+  label: kind === "session" ? "Session" : "Weekly",
+  usedPercent,
+  resetsAt: iso(resetInHours * HOUR),
+  windowDurationMins: kind === "session" ? 300 : 7 * 24 * 60,
+  checkedAt: iso(-60_000),
+});
+
+function provider(
+  instanceId: string,
+  windows: ReadonlyArray<ServerProviderUsageWindow>,
+  overrides: Partial<ServerProvider> = {},
+): ServerProvider {
+  return {
+    instanceId: ProviderInstanceId.make(instanceId),
+    driver: "claudeAgent",
+    displayName: instanceId,
+    enabled: true,
+    installed: true,
+    version: "1.0.0",
+    status: "ready",
+    auth: { status: "authenticated" },
+    checkedAt: iso(0),
+    models: [],
+    slashCommands: [],
+    skills: [],
+    usageLimits: { checkedAt: iso(-60_000), windows: [...windows] },
+    ...overrides,
+  } as ServerProvider;
+}
+
+describe("pickerSubscriptionUsage", () => {
+  it("shows the 5h and weekly windows like the stats line", () => {
+    const usage = pickerSubscriptionUsage(
+      provider("a", [window("session", 33, 2), window("weekly", 4, 100)]),
+      nowMs,
+    );
+    expect(usage.tier).toBe("ok");
+    expect(formatPickerUsageWindows(usage)).toBe("5h 33% · Week 4%");
+  });
+
+  it("marks a weekly allowance about to reset largely unused as use now", () => {
+    const usage = pickerSubscriptionUsage(
+      provider("a", [window("session", 0, 4), window("weekly", 20, 10)]),
+      nowMs,
+    );
+    expect(usage.tier).toBe("use-now");
+    expect(usage.reason).toContain("80% of the weekly allowance is unused");
+  });
+
+  it("says wait when a window is on pace to run out", () => {
+    // 80% used with 1 of 5 hours left: on pace for 100%.
+    const usage = pickerSubscriptionUsage(
+      provider("a", [window("session", 80, 1), window("weekly", 10, 100)]),
+      nowMs,
+    );
+    expect(usage.tier).toBe("wait");
+    expect(usage.windows[0]?.runningOut).toBe(true);
+  });
+});
+
+describe("sortByPickerUsage", () => {
+  it("orders from use now to do not use yet, then by weekly room per hour", () => {
+    const providers = [
+      provider("off", [window("weekly", 0, 10)], { enabled: false }),
+      provider("wait", [window("session", 95, 1), window("weekly", 10, 100)]),
+      provider("unknown", [], { usageLimits: undefined }),
+      provider("ok-slow", [window("weekly", 10, 150)]),
+      provider("ok-fast", [window("weekly", 50, 30)]),
+      provider("use-now", [window("weekly", 30, 12)]),
+    ];
+    const usage = pickerUsageByInstance(providers, nowMs);
+    expect(
+      sortByPickerUsage(providers, (p) => p.instanceId, usage).map((p) => p.instanceId),
+    ).toEqual(["use-now", "ok-fast", "ok-slow", "unknown", "wait", "off"]);
+  });
+});
diff --git a/apps/web/src/components/chat/ModelPickerUsage.logic.ts b/apps/web/src/components/chat/ModelPickerUsage.logic.ts
new file mode 100644
index 000000000..3422ddaf5
--- /dev/null
+++ b/apps/web/src/components/chat/ModelPickerUsage.logic.ts
@@ -0,0 +1,130 @@
+import type { ProviderInstanceId, ServerProvider } from "@t3tools/contracts";
+import { formatResetsIn } from "@t3tools/shared/usageLimits";
+
+import {
+  composerLimitDisplay,
+  composerLimitsFreshness,
+  selectComposerLimitWindows,
+} from "./ComposerStats.logic";
+import {
+  EXPIRING_MAX_USED_PERCENT,
+  EXPIRING_WITHIN_MS,
+  canRun,
+  describePace,
+  isRunningOut,
+  windowPace,
+} from "./SubscriptionSwitch.logic";
+
+/**
+ * Where a subscription belongs in the model picker, best to use first:
+ * `use-now` has a weekly allowance about to reset largely unused, `wait` is on
+ * pace to run out of a window, `unknown` has no recent reading and `off`
+ * cannot run at all.
+ */
+export type PickerUsageTier = "use-now" | "ok" | "unknown" | "wait" | "off";
+
+const TIER_ORDER: ReadonlyArray<PickerUsageTier> = ["use-now", "ok", "unknown", "wait", "off"];
+
+export interface PickerUsageWindow {
+  readonly shortLabel: string;
+  readonly percentText: string;
+  readonly runningOut: boolean;
+  readonly dimmed: boolean;
+}
+
+export interface PickerSubscriptionUsage {
+  readonly tier: PickerUsageTier;
+  /** Percent of the weekly allowance left per hour until it resets: how hard it needs using. */
+  readonly urgency: number;
+  /** The account-wide 5h and weekly windows, as the composer stats line shows them. */
+  readonly windows: ReadonlyArray<PickerUsageWindow>;
+  readonly reason: string | null;
+}
+
+const WEEK_HOURS = 7 * 24;
+
+export function pickerSubscriptionUsage(
+  provider: ServerProvider,
+  nowMs: number,
+): PickerSubscriptionUsage {
+  const limits = provider.usageLimits;
+  const selected = selectComposerLimitWindows(limits);
+  const paces = selected.map(({ window }) => windowPace(window, nowMs));
+  const windows = selected.map(({ window, shortLabel }, index) => {
+    const display = composerLimitDisplay(window, limits?.checkedAt, nowMs);
+    return {
+      shortLabel,
+      percentText: display.percentText,
+      runningOut: display.displayPercent !== null && isRunningOut(paces[index]!),
+      dimmed: display.dimmed,
+    };
+  });
+  const base = { urgency: 0, windows, reason: null };
+  if (!canRun(provider)) return { ...base, tier: "off" };
+  const fresh =
+    limits !== undefined &&
+    limits.unavailable === undefined &&
+    selected.length > 0 &&
+    composerLimitsFreshness(
+      selected.map(({ window }) => window.checkedAt ?? limits.checkedAt),
+      nowMs,
+    ).status !== "expired";
+  if (!fresh) return { ...base, tier: "unknown" };
+
+  const runningOut = paces.find(isRunningOut);
+  if (runningOut) return { ...base, tier: "wait", reason: describePace(runningOut, nowMs) };
+
+  const weekly = paces.find((pace) => pace.window.kind === "weekly");
+  const urgency = weekly
+    ? (100 - weekly.usedPercent) /
+      Math.max(1, weekly.resetInMs === null ? WEEK_HOURS : weekly.resetInMs / 3_600_000)
+    : 0;
+  if (
+    weekly &&
+    weekly.resetInMs !== null &&
+    weekly.resetInMs <= EXPIRING_WITHIN_MS &&
+    weekly.usedPercent <= EXPIRING_MAX_USED_PERCENT
+  ) {
+    const resets = formatResetsIn(weekly.window, nowMs) ?? "resets soon";
+    return {
+      ...base,
+      tier: "use-now",
+      urgency,
+      reason: `${Math.round(100 - weekly.usedPercent)}% of the ${weekly.window.label.toLowerCase()} allowance is unused and ${resets}`,
+    };
+  }
+  return { ...base, tier: "ok", urgency };
+}
+
+/** Usage per subscription, keyed by instance. */
+export function pickerUsageByInstance(
+  providers: ReadonlyArray<ServerProvider>,
+  nowMs: number,
+): ReadonlyMap<ProviderInstanceId, PickerSubscriptionUsage> {
+  return new Map(
+    providers.map((provider) => [provider.instanceId, pickerSubscriptionUsage(provider, nowMs)]),
+  );
+}
+
+/**
+ * Orders subscriptions from "use now" to "do not use yet": by tier, then by
+ * how much weekly allowance is left per hour until it resets. Ties keep their
+ * configured order.
+ */
+export function sortByPickerUsage<T>(
+  items: ReadonlyArray<T>,
+  instanceIdOf: (item: T) => ProviderInstanceId,
+  usageByInstance: ReadonlyMap<ProviderInstanceId, PickerSubscriptionUsage>,
+): T[] {
+  const tierRank = (usage: PickerSubscriptionUsage | undefined) =>
+    TIER_ORDER.indexOf(usage?.tier ?? "unknown");
+  return items.toSorted((a, b) => {
+    const usageA = usageByInstance.get(instanceIdOf(a));
+    const usageB = usageByInstance.get(instanceIdOf(b));
+    return tierRank(usageA) - tierRank(usageB) || (usageB?.urgency ?? 0) - (usageA?.urgency ?? 0);
+  });
+}
+
+export function formatPickerUsageWindows(usage: PickerSubscriptionUsage): string {
+  return usage.windows.map((window) => `${window.shortLabel} ${window.percentText}`).join(" · ");
+}
