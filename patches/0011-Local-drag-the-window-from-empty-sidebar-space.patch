@@ -3688,6 +3695,7 @@ export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReve
                             );
                             break;
                           case "working-header":
+                            if (sidebarDragOn) items.push(sidebarDragSpacer);
                             items.push(
                               <SidebarSectionHeader
                                 key="working-shelf-header"
@@ -3703,6 +3711,9 @@ export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReve
                             );
                             break;
                           case "snoozed-header":
+                            if (sidebarDragOn && workingThreads.length === 0) {
+                              items.push(sidebarDragSpacer);
+                            }
                             items.push(
                               <SidebarSectionHeader
                                 key="snoozed-shelf-header"
@@ -3718,6 +3729,12 @@ export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReve
                             );
                             break;
                           case "settled-header":
+                            if (
+                              sidebarDragOn &&
+                              workingThreads.length + snoozedThreads.length === 0
+                            ) {
+                              items.push(sidebarDragSpacer);
+                            }
                             items.push(
                               <SidebarSectionHeader
                                 key="settled-shelf-header"
