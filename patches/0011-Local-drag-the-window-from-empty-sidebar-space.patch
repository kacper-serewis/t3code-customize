 export default function Sidebar({ routeReveal }: { routeReveal: SidebarRouteReveal }) {
+  // Off in Settings → Customizations, empty sidebar space no longer drags the window.
+  const sidebarDragOn = useCustomizationEnabled("sidebar-drag") && isElectron;
