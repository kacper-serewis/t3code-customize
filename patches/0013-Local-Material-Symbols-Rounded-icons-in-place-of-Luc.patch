diff --git a/apps/web/vite/materialIcons.ts b/apps/web/vite/materialIcons.ts
new file mode 100644
index 0000000000..dec254366e
--- /dev/null
+++ b/apps/web/vite/materialIcons.ts
@@ -0,0 +1,15 @@
+import type { Plugin } from "vite-plus";
+
+import { MATERIAL_ICON_SHIM, shouldUseMaterialIcons } from "../src/lib/materialIconAlias";
+
+/** Serves Material Symbols Rounded wherever app code imports lucide-react. */
+export function materialIconsPlugin(): Plugin {
+  const shim = `${import.meta.dirname.replace(/[\\/]vite$/, "")}/${MATERIAL_ICON_SHIM}`;
+  return {
+    name: "t3code:material-icons",
+    enforce: "pre",
+    resolveId(source, importer) {
+      return shouldUseMaterialIcons(source, importer) ? shim : null;
+    },
+  };
+}
