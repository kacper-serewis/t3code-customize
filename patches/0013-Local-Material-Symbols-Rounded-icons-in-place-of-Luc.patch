@@ -0,0 +1,26 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { MATERIAL_ICON_SHIM, shouldUseMaterialIcons } from "./materialIconAlias";
+
+describe("shouldUseMaterialIcons", () => {
+  it("redirects app imports of lucide-react", () => {
+    expect(shouldUseMaterialIcons("lucide-react", "/repo/apps/web/src/components/Sidebar.tsx")).toBe(
+      true,
+    );
+    expect(shouldUseMaterialIcons("lucide-react", "C:\\repo\\apps\\web\\src\\a.tsx?v=1")).toBe(true);
+  });
+
+  it("leaves other imports alone", () => {
+    expect(shouldUseMaterialIcons("react", "/repo/apps/web/src/components/Sidebar.tsx")).toBe(false);
+    expect(shouldUseMaterialIcons("lucide-react/dynamic", "/repo/apps/web/src/a.tsx")).toBe(false);
+    expect(shouldUseMaterialIcons("lucide-react", undefined)).toBe(false);
+  });
+
+  it("keeps Lucide for the shim itself, the by-name lookup and dependencies", () => {
+    expect(shouldUseMaterialIcons("lucide-react", `/repo/apps/web/${MATERIAL_ICON_SHIM}`)).toBe(false);
+    expect(shouldUseMaterialIcons("lucide-react", "/repo/apps/web/src/lib/lucideIconByName.ts")).toBe(
+      false,
+    );
+    expect(shouldUseMaterialIcons("lucide-react", "/repo/node_modules/pkg/dist/index.js")).toBe(false);
+  });
+});
diff --git a/apps/web/src/lib/materialIconAlias.ts b/apps/web/src/lib/materialIconAlias.ts
new file mode 100644
index 0000000000..5afa550ac1
--- /dev/null
+++ b/apps/web/src/lib/materialIconAlias.ts
@@ -0,0 +1,13 @@
+/** The Material Symbols stand-in for lucide-react, relative to apps/web. */
+export const MATERIAL_ICON_SHIM = "src/components/icons/materialSymbols.generated.tsx";
+
+// Saved project icons are looked up by Lucide name across the whole set, so that module keeps Lucide.
+const LUCIDE_ONLY_IMPORTERS = [MATERIAL_ICON_SHIM, "src/lib/lucideIconByName.ts"];
+
+/** Whether an import of `source` from `importer` should get Material Symbols instead of Lucide. */
+export function shouldUseMaterialIcons(source: string, importer: string | undefined): boolean {
+  if (source !== "lucide-react" || importer === undefined) return false;
+  const path = importer.replaceAll("\\", "/").split("?")[0] ?? "";
+  if (path.includes("/node_modules/")) return false;
+  return !LUCIDE_ONLY_IMPORTERS.some((file) => path.endsWith(`/${file}`));
+}
