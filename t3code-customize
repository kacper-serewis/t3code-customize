class Stop(Exception):
    """A clean stop with a message for the user."""


class NeedsFix(Stop):
    """The patches need porting to this upstream commit (conflict or failing check)."""


def say(message=''):
    print(message, flush=True)


def step(message):
    say('==> ' + message)


def run(args, cwd=None, env=None, log=None, check=True, capture=False):
    # Output goes to the log, so nothing may wait for an answer the user cannot see.
    result = subprocess.run(args, cwd=cwd, env=env, text=capture, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE if capture else log,
                            stderr=log if not capture else None)
    if check and result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {" ".join(map(str, args))}' + (f'\nLog: {log.name}' if log else ''))
    return result.stdout if capture else result


def git(*args, check=True, capture=True, log=None):
    env = {**os.environ, **GIT_ENV}
    return run(['git', '-c', 'core.hooksPath=/dev/null', *args], cwd=SOURCE, env=env, check=check, capture=capture, log=log)


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def load(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    os.replace(temporary, path)


def patches():
    return sorted((REPO / 'patches').glob('*.patch'))


def catalog():
    """Every patch in order, with the id, title and requirements patches/patches.json gives it."""
    manifest = load(REPO / 'patches/patches.json', {})
    by_file = {info['file']: (pid, info) for pid, info in manifest.items()}
    entries = []
    for path in patches():
        # format-patch names each file NNNN-<subject>; the subject part survives a port.
        slug = re.sub(r'^\d+-', '', path.stem)
        pid, info = by_file.get(slug, (slug, {}))
        entries.append({'id': pid, 'path': path, 'title': info.get('title', slug),
                        'requires': info.get('requires', []), 'listed': slug in by_file})
    return entries


def switched_off():
    """Patch ids the user turned off with `patches off`."""
    return set(load(CONFIG / 'config.json', {}).get('disabledPatches', []))


def selection(entries=None, off=None):
    """The patches to build: all but those switched off and those that need one that is off."""
    entries = catalog() if entries is None else entries
    off = switched_off() if off is None else set(off)
    dropped = set()
    for pid in off:
        dropped |= dependents(entries, pid)
    return [entry for entry in entries if entry['id'] not in dropped]


def requirements(entries, pid):
    """pid and every patch it needs, directly or through another. Two patches may need each other."""
    requires = {entry['id']: set(entry['requires']) for entry in entries}
    needed, todo = set(), [pid]
    while todo:
        current = todo.pop()
        if current not in needed:
            needed.add(current)
            todo += requires.get(current, ())
    return needed


def dependents(entries, pid):
    """pid and every patch that needs it, directly or through another."""
    return {entry['id'] for entry in entries if pid in requirements(entries, entry['id'])}


def recipe_hash():
    digest = hashlib.sha256()
    for path in patches() + [REPO / 'patches/base.txt', REPO / 'patches/patches.json', REPO / 'checks.json']:
        if path.exists():
            digest.update(path.name.encode() + path.read_bytes())
    # Turning a patch off or on makes a different build.
    digest.update(','.join(entry['id'] for entry in selection()).encode())
    return digest.hexdigest()[:12]


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def extract_tar(archive, destination):
    with tarfile.open(archive) as bundle:
        if hasattr(tarfile, 'data_filter'):
            bundle.extractall(destination, filter='data')
        else:
            bundle.extractall(destination)


# --- Finding the installed AppImage -------------------------------------------------

def version_key(path):
    return [int(part) if part.isdigit() else part for part in re.split(r'(\d+)', path.name)]


def find_app(explicit=None):
    """The installed T3 Code: an AppImage on Linux, an .app bundle on macOS."""
    return find_mac_app(explicit) if MAC else find_appimage(explicit)


def find_mac_app(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not (path / 'Contents/Resources/app.asar').is_file():
            raise Stop(f'No T3 Code app at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured and (Path(configured) / 'Contents/Resources/app.asar').is_file():
        return Path(configured)
    for folder in MAC_SEARCH:
        if (folder / MAC_APP / 'Contents/Resources/app.asar').is_file():
            return folder / MAC_APP
    raise Stop(f'Could not find {MAC_APP} in ' + ' or '.join(map(str, MAC_SEARCH)) + '.\n'
               f'Point to it once with: {NAME} --app "/path/to/{MAC_APP}"')


def stock_asar(app):
    return app / 'Contents/Resources/app.asar' if MAC else None


def mac_binary(app):
    return app / 'Contents/MacOS' / app.stem


def find_appimage(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not path.is_file():
            raise Stop(f'No AppImage at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured:
        path = Path(configured)
        if path.is_file():
            return path.resolve()
        # T3's updater replaces versioned files; look again in the same folder.
        found = sorted((p for p in path.parent.glob('T3-Code*.AppImage') if p.is_file()), key=version_key)
        if found:
            return found[-1].resolve()
    found = [p for folder in SEARCH for p in (HOME / folder).glob('T3-Code*.AppImage') if p.is_file()]
    if not found:
        raise Stop('Could not find your T3 Code AppImage in ~/' + ', ~/'.join(SEARCH) + '.\n'
                   f'Point to it once with: {NAME} --appimage /path/to/T3-Code-....AppImage')
    return sorted(found, key=version_key)[-1].resolve()


def fingerprint(path):
    # On macOS the bundle is a folder; its app.asar changes with every update.
    stat = (stock_asar(path) if MAC else path).stat()
    return {'path': str(path), 'size': stat.st_size, 'mtime': stat.st_mtime_ns}


# --- Electron asar archives ---------------------------------------------------------

class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(archive):
    """Upstream's public cloud config from the stock web bundle, by name."""
    found = {}
    for _, data in archive.scripts('apps/server/dist/client/'):
        for name in PUBLIC_CONFIG:
            if name in found:
                continue
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
            if match:
                found[name] = match.group(2).decode()
        if len(found) == len(PUBLIC_CONFIG):
            break
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config, markers):
    """Write stock_path with the server and desktop bundles replaced by build's, then verify it."""
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        node('apps/server/dist')['files']['client'] = {'files': {}}
        overlays = {}
        for prefix in ('apps/server/dist', 'apps/desktop/dist-electron'):
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if key in overlays or key.startswith('apps/server/dist/client/'):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            check_bundles(stock, patched, config, markers)
        finally:
            patched.close()
    finally:
        stock.close()


class Folder:
    """A build output folder, read like an Archive."""

    def __init__(self, root):
        self.root = Path(root)

    def scripts(self, prefix):
        for path in sorted((self.root / prefix).rglob('*')):
            if path.is_file() and path.suffix in ('.js', '.mjs', '.cjs'):
                yield path.relative_to(self.root).as_posix(), path.read_bytes()


def check_bundles(stock, patched, config, markers):
    """The rebuilt bundles carry the patches and the same T3 Connect config as stock."""
    for pid in markers:
        for prefix, marker in MARKERS.get(pid, ()):
            if not any(marker in data for _, data in patched.scripts(prefix)):
                raise Stop(f'The rebuilt bundle under {prefix} is missing the {pid} patch.')
    # Connect needs the same public config as stock in every bundle that carries it.
    for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
        def contents(archive):
            return b''.join(data for key, data in archive.scripts(prefix)
                            if prefix.endswith('client/') or '/client/' not in key)
        stock_data, patched_data = contents(stock), contents(patched)
        for key, value in config.items():
            if value.encode() in stock_data and value.encode() not in patched_data:
                raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')


def assemble_mac(stock_path, output, build, config, markers):
    """Write the rebuilt bundles and the loader to output, then verify them against stock."""
    overlay = output / 'overlay'
    for prefix in ('apps/server/dist', 'apps/desktop/dist-electron'):
        for path in (build / prefix).rglob('*'):
            if path.is_symlink():
                raise Stop('Unexpected symlink in the build output: ' + str(path))
        shutil.copytree(build / prefix, overlay / prefix)
    for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                     'apps/desktop/dist-electron/boot.cjs', 'apps/desktop/dist-electron/main.cjs'):
        if not (overlay / required).is_file():
            raise Stop('The build did not produce ' + required)
    for name in ('inject.cjs', 'connect.mjs'):
        shutil.copy2(REPO / 'macos' / name, output / name)
    stock = Archive(stock_path)
    try:
        # The app loads boot.cjs before the customization exists, so it must stay as shipped.
        if stock.read('apps/desktop/dist-electron/boot.cjs') != (overlay / 'apps/desktop/dist-electron/boot.cjs').read_bytes():
            raise Stop('The rebuilt boot.cjs differs from your app; the customization cannot load into it.')
        check_bundles(stock, Folder(overlay), config, markers)
    finally:
        stock.close()


def electron_fuses(app):
    """Electron's fuse wire from the app's framework binary, e.g. {'EnableNodeCliInspectArguments': '1'}."""
    names = ['RunAsNode', 'EnableCookieEncryption', 'EnableNodeOptionsEnvironmentVariable',
             'EnableNodeCliInspectArguments', 'EnableEmbeddedAsarIntegrityValidation', 'OnlyLoadAppFromAsar',
             'LoadBrowserProcessSpecificV8Snapshot', 'GrantFileProtocolExtraPrivileges']
    data = (app / 'Contents/Frameworks/Electron Framework.framework/Electron Framework').read_bytes()
    start = data.find(b'dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX')
    if start < 0:
        return {}
    start += 32
    wire = data[start + 2:start + 2 + data[start + 1]].decode('ascii', 'replace')
    return dict(zip(names, wire))


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def required_node_major(commit):
    """The Node major the source pins in package.json engines, at least 24."""
    try:
        engines = json.loads(git('show', commit + ':package.json')).get('engines', {}).get('node', '')
        return max(24, int(re.search(r'\d+', engines).group()))
    except (subprocess.CalledProcessError, ValueError, AttributeError):
        return 24


def ensure_node(commit, log):
    """Use the system Node if it is new enough, else a private copy from nodejs.org."""
    major = required_node_major(commit)
    system = shutil.which('node')
    if system and node_major(system) >= major:
        return None
    arch = ARCH.get(os.uname().machine)
    if not arch:
        raise Stop(f'Node {major} or newer is required. Install it and run again.')
    # nodejs.org names the macOS builds darwin-* and lists them as osx-*-tar.
    platform, listed = ('darwin', f'osx-{arch}-tar') if MAC else ('linux', f'linux-{arch}')
    private = sorted((CACHE / 'node').glob(f'node-v{major}.*-{platform}-{arch}'), key=version_key)
    if private and node_major(str(private[-1] / 'bin/node')) >= major:
        return private[-1] / 'bin'
    step(f'Downloading Node {major} (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    version = next(r['version'] for r in releases if r['version'].startswith(f'v{major}.') and listed in r['files'])
    name = f'node-{version}-{platform}-{arch}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + '.tar.xz')
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    extract_tar(archive, folder)
    archive.unlink()
    return folder / name / 'bin'


def build_env(node_bin):
    env = os.environ.copy()
    paths = [str(SOURCE / 'node_modules/.bin')] + ([str(node_bin)] if node_bin else [])
    env['PATH'] = os.pathsep.join(paths + [env.get('PATH', '')])
    # Corepack otherwise asks before fetching the pnpm version the source pins.
    env['COREPACK_ENABLE_DOWNLOAD_PROMPT'] = '0'
    # ELECTRON_RUN_AS_NODE leaks in when this runs from a terminal inside T3 Code.
    for key in ('T3CODE_DESKTOP_DEV', 'VITE_HTTP_URL', 'VITE_WS_URL', 'NODE_ENV', 'ELECTRON_RUN_AS_NODE'):
        env.pop(key, None)
    # Nothing from the user's shell may stand in for upstream config.
    for key in list(env):
        if key.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_')):
            env.pop(key)
    return env


def pnpm(env):
    if shutil.which('pnpm', path=env['PATH']):
        return ['pnpm']
    manager = json.loads((SOURCE / 'package.json').read_text()).get('packageManager', 'pnpm')
    return ['npx', '--yes', manager.split('+')[0]]


# --- Source checkout ----------------------------------------------------------------

def rebase_in_progress():
    gitdir = Path(git('rev-parse', '--absolute-git-dir').strip())
    return (gitdir / 'rebase-merge').exists() or (gitdir / 'rebase-apply').exists()


def has_commit(ref):
    return git('cat-file', '-e', ref + '^{commit}', check=False, capture=False).returncode == 0


def ensure_commit(commit, version, log):
    if not (SOURCE / '.git').exists() and (OLD_SOURCE / '.git').exists():
        # Earlier versions kept the checkout under the cache folder.
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(OLD_SOURCE), SOURCE)
    if not (SOURCE / '.git').exists():
        step('Downloading T3 Code source history (one time)...')
        shutil.rmtree(SOURCE, ignore_errors=True)
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        run(['git', 'clone', '--filter=blob:none', '--no-checkout', UPSTREAM, str(SOURCE)], log=log)
    if not has_commit(commit):
        git('fetch', '--quiet', 'origin', capture=False, log=log, check=False)
        if version and not has_commit(commit):
            git('fetch', '--quiet', 'origin', 'tag', 'v' + version, capture=False, log=log, check=False)
    if not has_commit(commit):
        raise Stop(f'Upstream commit {commit} is not on GitHub yet. Try again in a little while.')
    return git('rev-parse', commit + '^{commit}').strip()


def apply_at_base(base, entries, log):
    """Check out base with entries applied as commits, or stop at the first one that does not apply."""
    if rebase_in_progress():
        # Start over from the repo's patches; a fresh build never continues an old port.
        git('am', '--abort', check=False, capture=False, log=log)
        git('rebase', '--abort', check=False, capture=False, log=log)
    git('checkout', '--quiet', '--force', '--detach', base, capture=False, log=log)
    # Keep node_modules so dependency installs stay fast between builds.
    git('clean', '-ffdxq', '-e', 'node_modules', capture=False, log=log)
    for entry in entries:
        if git('am', '--quiet', '--committer-date-is-author-date', str(entry['path']), check=False, capture=False, log=log).returncode:
            git('am', '--abort', check=False, capture=False, log=log)
            return entry
    return None


def prepare(target, log, resume=False, entries=None):
    """Leave SOURCE with the chosen patches (all by default) as commits on top of target."""
    base = (REPO / 'patches/base.txt').read_text().strip()
    everything = catalog()
    entries = everything if entries is None else entries
    if not resume:
        failed = apply_at_base(base, entries, log)
        if failed and len(entries) < len(everything):
            raise Stop(f'The {failed["id"]} patch does not apply without the patches that are off. It needs one of them;\n'
                       f'list it under "requires" in {REPO / "patches/patches.json"}, or turn them back on.')
        if failed:
            raise Stop(f'The patches do not apply to their own base {base[:12]} ({failed["path"].name}). Check git status in {REPO}.')
        if base != target:
            git('rebase', '--quiet', '--onto', target, base, check=False, capture=False, log=log)
    if rebase_in_progress():
        conflicted = git('diff', '--name-only', '--diff-filter=U').split()
        raise NeedsFix('The patches conflict with this nightly in:\n' + '\n'.join('  ' + f for f in conflicted))
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix('The source checkout has uncommitted changes in ' + str(SOURCE) + '.')
    if git('merge-base', '--is-ancestor', target, 'HEAD', check=False, capture=False).returncode:
        raise NeedsFix('The patch commits are not on top of the nightly commit ' + target[:12] + '.')


def install_dependencies(env, log):
    first = not (SOURCE / 'node_modules').exists()
    step('Installing build dependencies' + (' (one time, a few minutes)...' if first else '...'))
    # Only JavaScript is rebuilt; native parts come from your own app, so no install scripts run.
    run([*pnpm(env), 'install', *PNPM_INSTALL], cwd=SOURCE, env=env, log=log)


def created_files(path):
    """Files a patch adds."""
    return set(re.findall(r'^diff --git a/\S+ b/(\S+)\nnew file mode', path.read_text(errors='replace'), re.M))


def checks(env, log, entries=None):
    spec = json.loads((REPO / 'checks.json').read_text())
    # Tests that a patch which is off would add are not in the checkout; they have nothing to test.
    absent = set()
    if entries is not None:
        chosen = {entry['id'] for entry in entries}
        for entry in catalog():
            if entry['id'] not in chosen:
                absent |= created_files(entry['path'])
    tests = [t for t in spec['tests'] if t not in absent]
    missing = [t for t in tests if not (SOURCE / t).exists()]
    if missing:
        raise NeedsFix('Test files listed in checks.json no longer exist (moved upstream?):\n' + '\n'.join('  ' + t for t in missing))
    step('Testing the patches...')
    steps = [(['vp', 'test', 'run', *tests], SOURCE, 'The patch tests failed.')] if tests else []
    # Upstream typechecks each package with the tsrs checker; there is no tsc.
    steps += [(['effect-tsgo', 'tsrs', '--noEmit'], SOURCE / p, f'Typecheck failed in {p}.') for p in spec['typecheck']]
    for args, cwd, message in steps:
        if run(args, cwd=cwd, env=env, log=log, check=False).returncode:
            raise NeedsFix(message + ' Command: ' + ' '.join(args) + f' (in {cwd})')


def build_bundles(env, version, stock_root, config, log):
    step('Building T3 Code...')
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'), **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    packages = [SOURCE / 'apps' / app / 'package.json' for app in ('web', 'server', 'desktop')]
    # The desktop build regenerates this tracked file; put the committed copy back afterwards.
    generated = [SOURCE / 'apps/desktop/src/preview/AnnotationStyles.generated.ts']
    originals = {path: path.read_bytes() for path in packages + generated if path.exists()}
    try:
        for path in packages:
            package = json.loads(originals[path])
            package['version'] = version
            path.write_text(json.dumps(package, indent=2) + '\n')
        run(['vp', 'build'], cwd=SOURCE / 'apps/web', env=env, log=log)
        run(['node', 'scripts/cli.ts', 'build'], cwd=SOURCE / 'apps/server', env=env, log=log)
        brand = 'nightly' if 'nightly' in version else 'production'
        run(['node', 'scripts/apply-web-brand-assets.ts', brand, 'apps/server/dist/client'], cwd=SOURCE, env=env, log=log)
        # Reuse the native helper from your own app instead of compiling it.
        arch = ARCH.get(os.uname().machine, 'x64')
        helper = SOURCE / f'native/browser-secret/build/{arch}/t3-browser-secret'
        stock_helper = stock_root / 'resources/browser-secret/t3-browser-secret'
        if stock_helper.exists():
            helper.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(stock_helper, helper)
            os.utime(helper, None)
        run(['node', 'scripts/build-browser-secret.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['node', 'scripts/build-preview-annotation-css.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['vp', 'pack'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
    finally:
        for path, original in originals.items():
            path.write_bytes(original)


# --- Porting help -------------------------------------------------------------------

def available_agents():
    return [name for name in AGENTS if shutil.which(name)]


def choose_agent(requested):
    """The agent to port the patches with, asking first when run by a person."""
    if requested:
        if not shutil.which(requested):
            raise Stop(f'{requested} is not installed.')
        return requested
    agents = available_agents()
    if not agents or not interactive():
        return None
    name = agents[0]
    say()
    say(f'This nightly changed code the patches touch. {AGENT_NAMES[name]} can port them for you')
    say(f'(usually 10 to 30 minutes). It runs with full permissions, only inside {SOURCE}.')
    answer = input(f'Let {AGENT_NAMES[name]} fix it now? [Y/n] ').strip().lower()
    return name if answer in ('', 'y', 'yes') else None


def agent_fix(agent, problem, target, version, log, entries):
    everything = catalog()
    subset = ''
    if len(entries) < len(everything):
        off = [e['path'].name for e in everything if e not in entries]
        subset = ('The user turned some patches off, so the checkout only has these: '
                  + ', '.join(e['path'].name for e in entries) + '.\nPort only those. Do not add the ones that are off: '
                  + ', '.join(off) + '.\n\n')
    prompt = (f'Follow {REPO}/AGENTS.md to port the T3 Code customization patches.\n\n'
              f'Source checkout: {SOURCE}\nNightly: {version} at commit {target}\n'
              f'Patch repo: {REPO}\n\n{subset}The build stopped with:\n\n{problem}\n\n'
              f'When the checks pass, stop. Do not run the build yourself; {NAME} continues it.\n')
    step(f'{AGENT_NAMES[agent]} is porting the patches. Transcript: {log.name}')
    log.write('\n--- agent prompt ---\n' + prompt + '\n')
    log.flush()
    result = subprocess.run(AGENTS[agent], cwd=SOURCE, input=prompt, text=True, stdout=log, stderr=log)
    if result.returncode:
        say(f'{AGENT_NAMES[agent]} exited with {result.returncode}; checking what it left.')


def older_than_patches(target):
    base = (REPO / 'patches/base.txt').read_text().strip()
    return target != base and git('merge-base', '--is-ancestor', target, base, check=False, capture=False).returncode == 0


def stuck_message(problem, target):
    if older_than_patches(target):
        return (f'{problem}\n\nYour T3 Code is older than these patches. Update T3 Code, then run {NAME} again.\n'
                'Your current T3 Code is untouched.')
    return (f'{problem}\n\nThis nightly changed code the patches touch. Any of these works:\n'
            f'  - wait for the repo to catch up (usually within a day), then run {NAME} again\n'
            f'  - let an agent port them now: {NAME} --fix claude  (or --fix codex)\n'
            f'  - or ask your coding agent to follow {REPO}/AGENTS.md\n'
            'Your current T3 Code is untouched and still opens normally.')


# --- Commands -----------------------------------------------------------------------

def pull_latest():
    """Fast-forward this repo to the latest patches, keeping any local port in a backup."""
    if not (REPO / '.git').exists():
        return
    status = subprocess.run(['git', 'status', '--porcelain', '--', 'patches', 'checks.json'],
                            cwd=REPO, capture_output=True, text=True).stdout
    before = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if subprocess.run(['git', 'fetch', '--quiet'], cwd=REPO, stderr=subprocess.DEVNULL).returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    behind = subprocess.run(['git', 'rev-list', '--count', 'HEAD..@{u}'], cwd=REPO, capture_output=True, text=True).stdout.strip()
    if behind in ('', '0'):
        return
    if status.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches', 'checks.json'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    if subprocess.run(['git', 'merge', '--ff-only', '--quiet', '@{u}'], cwd=REPO).returncode:
        raise Stop(f'Could not update {REPO} to the latest patches. Run git status there.')
    after = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=REPO, capture_output=True, text=True).stdout
    if after != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        os.execv(sys.executable, [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull'])


def install_launcher(appimage):
    BIN.parent.mkdir(parents=True, exist_ok=True)
    if BIN.is_symlink() or not BIN.exists():
        BIN.unlink(missing_ok=True)
        BIN.symlink_to(REPO / NAME)
    if MAC:
        # The agents open T3 Code with the customization, so the regular icon is enough.
        shutil.rmtree(MAC_LAUNCHER, ignore_errors=True)
        install_mac_agents()
    else:
        install_desktop_entry()
    if str(BIN.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        say(f'Note: {BIN.parent} is not on your PATH. Add it to run {NAME} from anywhere.')


def install_mac_launcher(app):
    """A small app in ~/Applications that runs `launch`, so it shows up in Spotlight and Launchpad."""
    contents = MAC_LAUNCHER / 'Contents'
    (contents / 'MacOS').mkdir(parents=True, exist_ok=True)
    (contents / 'Resources').mkdir(exist_ok=True)
    with (contents / 'Info.plist').open('wb') as plist:
        plistlib.dump({
            'CFBundleName': LAUNCHER_NAME, 'CFBundleDisplayName': LAUNCHER_NAME,
            'CFBundleIdentifier': 'io.github.btsouth.t3code-customize', 'CFBundleExecutable': 'launch',
            'CFBundleIconFile': 'icon', 'CFBundlePackageType': 'APPL', 'CFBundleVersion': '1',
            # The launcher exits once T3 Code is up; keep it out of the Dock.
            'LSUIElement': True,
        }, plist)
    script = contents / 'MacOS/launch'
    logs = CACHE / 'logs'
    # Apps opened from Finder do not see the shell's environment; keep the folders this build used.
    exports = ''.join(f'export {key}="{os.environ[key]}"\n' for key in ('XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME')
                      if os.environ.get(key))
    script.write_text(f'#!/bin/sh\n{exports}mkdir -p "{logs}"\n'
                      f'exec "{sys.executable}" "{REPO / NAME}" launch >>"{logs}/launch.log" 2>&1\n')
    script.chmod(0o755)
    icon = app / 'Contents/Resources/icon.icns'
    if icon.exists():
        shutil.copy2(icon, contents / 'Resources/icon.icns')
    os.utime(MAC_LAUNCHER, None)


def mac_agent_plist(label):
    return MAC_AGENTS / (label + '.plist')


def install_mac_agents():
    """Login and watch agents, so the regular T3 Code icon opens the customized build."""
    MAC_AGENTS.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    env = {key: os.environ[key] for key in ('XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME') if os.environ.get(key)}
    for label, command, extra in ((MAC_LOGIN_AGENT, 'launch', {}),
                                  (MAC_WATCH_AGENT, 'watch', {'KeepAlive': True, 'ThrottleInterval': 30})):
        plist = {'Label': label, 'ProgramArguments': [sys.executable, str(REPO / NAME), command],
                 'RunAtLoad': True, 'ProcessType': 'Interactive',
                 'StandardOutPath': str(logs / (command + '.log')), 'StandardErrorPath': str(logs / (command + '.log')),
                 **({'EnvironmentVariables': env} if env else {}), **extra}
        path = mac_agent_plist(label)
        changed = not (path.exists() and plistlib.loads(path.read_bytes()) == plist)
        if changed:
            with path.open('wb') as out:
                plistlib.dump(plist, out)
        # The login agent waits for the next login; loading it now would bring T3 Code forward.
        # The watcher must be running after every build, also when its plist did not change.
        if label == MAC_WATCH_AGENT:
            load_mac_agent(label, path, reload=changed)


def mac_agent_loaded(label):
    return subprocess.run(['launchctl', 'print', f'gui/{os.getuid()}/{label}'],
                          check=False, capture_output=True).returncode == 0


def load_mac_agent(label, path, reload):
    """Loads an agent, first unloading it when `reload`. Warns when launchd will not take it."""
    target = f'gui/{os.getuid()}'
    if reload and mac_agent_loaded(label):
        subprocess.run(['launchctl', 'bootout', f'{target}/{label}'], check=False, capture_output=True)
        # bootout returns before the agent is gone, and bootstrap fails until it is.
        for _ in range(50):
            if not mac_agent_loaded(label):
                break
            time.sleep(0.1)
    error = ''
    for _ in range(5):
        if mac_agent_loaded(label):
            return
        result = subprocess.run(['launchctl', 'bootstrap', target, str(path)], check=False,
                                capture_output=True, text=True)
        if result.returncode == 0:
            return
        error = (result.stderr or result.stdout).strip()
        time.sleep(0.5)
    if not mac_agent_loaded(label):
        say(f'Warning: could not start {label}: {error or "launchctl refused it"}.\n'
            f'  T3 Code opened from the Dock stays stock. Run: launchctl bootstrap {target} "{path}"')


def remove_mac_agents():
    for label in (MAC_LOGIN_AGENT, MAC_WATCH_AGENT):
        subprocess.run(['launchctl', 'bootout', f'gui/{os.getuid()}/{label}'], check=False, capture_output=True)
        mac_agent_plist(label).unlink(missing_ok=True)


def install_desktop_entry():
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP.write_text('\n'.join([
        '[Desktop Entry]', 'Type=Application', f'Name={LAUNCHER_NAME}',
        'Comment=T3 Code with a stats bar under the composer',
        f'Exec="{BIN}" launch %U', f'Icon={DATA / "icon.png"}', 'Terminal=false',
        'StartupWMClass=com.t3tools.T3Code', 'Categories=Development;', '']))
    if shutil.which('update-desktop-database'):
        subprocess.run(['update-desktop-database', str(DESKTOP.parent)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def built():
    """A file that exists once the current build is complete."""
    return CURRENT / ('inject.cjs' if MAC else 'AppRun')


def cmd_build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    appimage = find_app(args.appimage)
    if args.appimage:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'appimage': str(appimage)})
    say('T3 Code: ' + str(appimage))
    if MAC and electron_fuses(appimage).get('EnableNodeCliInspectArguments') != '1':
        raise Stop('This T3 Code no longer lets a launcher hook into its startup, so the customization cannot load\n'
                   'into the signed app. Your current T3 Code is untouched.')
    state = load(STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('stock') == fingerprint(appimage)
            and state.get('recipe') == recipe and built().exists()):
        install_launcher(appimage)
        say('\nAlready up to date. ' + ('Quit T3 Code fully and reopen it.' if MAC else f'Open "{LAUNCHER_NAME}" from your app launcher.'))
        return
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        if MAC:
            # Read in place: the signed app is never copied or changed.
            stock_root = appimage
            archive = Archive(stock_asar(appimage))
        else:
            run([str(appimage), '--appimage-extract'], cwd=job, log=log)
            stock_root = job / 'squashfs-root'
            archive = Archive(stock_root / 'resources/app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
            config = read_public_config(archive)
        finally:
            archive.close()
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        if 'nightly' not in version:
            raise Stop(f'This is T3 Code {version}. The patches target T3 Code Nightly; install Nightly and run again.')
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This T3 Code does not record its source commit, so it cannot be rebuilt exactly.')
        say(f'    Nightly {version}, upstream commit {commit[:12]}')
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        target = ensure_commit(commit, version, log)
        env = build_env(ensure_node(target, log))
        entries = selection()
        enabled_ids = [entry['id'] for entry in entries]
        if not entries:
            raise Stop(f'Every patch is off, so there is nothing to build. Turn some on with {NAME} patches,\n'
                       f'or use {NAME} off to open stock T3 Code.')
        total = len(catalog())
        step('Applying the patches...' if len(entries) == total else
             f'Applying {len(entries)} of {total} patches (off: {", ".join(e["id"] for e in catalog() if e["id"] not in enabled_ids)})...')
        attempts = 2
        resume = ported = args.resume
        agent = None
        while True:
            try:
                prepare(target, log, resume=resume, entries=entries)
                install_dependencies(env, log)
                if not args.skip_checks:
                    checks(env, log, entries)
                break
            except NeedsFix as problem:
                if older_than_patches(target):
                    raise Stop(stuck_message(problem, target))
                say(str(problem))
                if len(entries) < total:
                    say(f'Some patches are off. If this nightly is not the cause, a patch that is on may need one that is off;\n'
                        f'turn that one back on with {NAME} patches, and list it under "requires" in patches/patches.json.')
                agent = agent or choose_agent(args.fix)
                if not agent or attempts == 0:
                    raise NeedsFix(stuck_message(problem, target))
                attempts -= 1
                agent_fix(agent, str(problem), target, version, log, entries)
                resume = ported = True
        head = git('rev-parse', 'HEAD').strip()
        build_bundles(env, version, stock_root, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        step('Assembling and verifying your customized app...')
        if MAC:
            assembled = job / 'build'
            assemble_mac(stock_asar(appimage), assembled, SOURCE, config, enabled_ids)
        else:
            output = job / 'app.asar'
            overlay(stock_root / 'resources/app.asar', output, SOURCE, config, enabled_ids)
            shutil.move(str(output), stock_root / 'resources/app.asar')
            assembled = stock_root
        # A port of only some patches cannot replace the full set in patches/.
        saved = ported and len(entries) == total
        if saved:
            export_patches(target)
        destination = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(assembled), destination)
        link = DATA / 'current.new'
        if link.is_symlink():
            link.unlink()
        link.symlink_to(destination.relative_to(DATA))
        os.replace(link, CURRENT)
        save(STATE, {'stock': fingerprint(appimage), 'version': version, 'commit': target, 'recipe': recipe_hash(),
                     'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG), 'patches': enabled_ids,
                     'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
    shutil.rmtree(job, ignore_errors=True)
    install_launcher(appimage)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: T3 Code {version} with ' +
        ('the stats bar.' if len(entries) == total else f'{len(entries)} of {total} patches.'))
    if saved:
        say(f'The ported patches were saved to {REPO / "patches"}.')
    elif ported:
        say(f'Some patches are off, so this port was not saved to {REPO / "patches"}.\n'
            f'To port the full set, turn them all on ({NAME} patches on --all) and run {NAME} again.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say('Quit T3 Code fully and reopen it.' if MAC else f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        if 'stats' in enabled_ids:
            say('First time? Turn on Settings > General > Stats for nerds.')


def export_patches(target):
    """Keep a port that an agent or you finished, so the next build starts from it."""
    out = REPO / 'patches'
    for path in patches():
        path.unlink()
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..HEAD', capture=False)
    (out / 'base.txt').write_text(target + '\n')


def prune(keep=3):
    """Drop old builds, keeping the newest few so a running instance never loses its files."""
    current = CURRENT.resolve()
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in builds[keep:]:
        if old.resolve() != current:
            shutil.rmtree(old, ignore_errors=True)


def verify_manifest(base, log):
    """Every patch is in patches.json, and applies to base with only the patches it requires."""
    step('Checking that each patch applies with only what it requires...')
    entries = catalog()
    ids = [entry['id'] for entry in entries]
    problems = [f'{e["path"].name} is not listed in patches/patches.json.' for e in entries if not e['listed']]
    problems += [f'{e["id"]} requires {r}, which is not another patch.'
                 for e in entries for r in e['requires'] if r not in ids or r == e['id']]
    if problems:
        raise Stop('\n'.join(problems))
    for entry in entries:
        # Everything this patch is not, and does not require, is off.
        failed = apply_at_base(base, selection(entries, set(ids) - requirements(entries, entry['id'])), log)
        if failed:
            raise Stop(f'{entry["id"]} does not apply with only what it requires ({failed["id"]} failed).\n'
                       f'Add what it builds on to its "requires" in patches/patches.json.')


def cmd_verify(args):
    """Apply the patches to their base and run the checks. No AppImage needed (used by CI)."""
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    base = (REPO / 'patches/base.txt').read_text().strip()
    with (logs / ('verify-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w') as log:
        say('Log: ' + log.name)
        target = ensure_commit(base, None, log)
        env = build_env(ensure_node(target, log))
        verify_manifest(base, log)
        prepare(target, log)
        install_dependencies(env, log)
        checks(env, log)
    say('Patches apply and pass their checks on ' + base[:12] + '.')


def launch_target():
    """The customized build if it was made from the T3 Code installed right now, else stock."""
    appimage = find_app()
    state = load(STATE, {})
    if DISABLED.exists() or not built().exists():
        return appimage, None
    if state.get('stock') != fingerprint(appimage):
        return appimage, f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    return built().resolve() if not MAC else CURRENT.resolve(), None


