    script = f'application id "{MAC_BUNDLE_ID}" is running'
    return subprocess.run(['osascript', '-e', script], capture_output=True, text=True).stdout.strip() == 'true'


def free_port():
    with socket.socket() as probe:
        probe.bind(('127.0.0.1', 0))
        return probe.getsockname()[1]


def launch_mac(app, target, rest):
    rest = [arg for arg in rest if not arg.startswith('-psn_')]
    if mac_running():
        # A running T3 Code keeps what it started with; this only brings it forward.
        subprocess.run(['open', str(app)], check=False)
        return
    if target == app:
        os.execvp('open', ['open', str(app), *(['--args', *rest] if rest else [])])
    # T3 Code waits at its first line until connect.mjs has loaded the build into it.
    port = free_port()
    subprocess.run(['open', str(app), '--args', f'--inspect-brk=127.0.0.1:{port}', *rest], check=True)
    result = subprocess.run([str(mac_binary(app)), str(target / 'connect.mjs'), str(port),
                             str(target / 'inject.cjs'), str(target / 'overlay')],
                            env={**os.environ, 'ELECTRON_RUN_AS_NODE': '1'}, capture_output=True, text=True)
    if result.returncode:
        notify('Opened stock T3 Code', (result.stderr.strip().splitlines() or ['The customization did not load.'])[-1])
    else:
        say(f'Opened T3 Code with the customization from {target}.')


def mac_main_processes(binary):
    """PIDs of T3 Code main processes, and whether each one started with the customization hook."""
    out = subprocess.run(['ps', '-axo', 'pid=,ppid=,args='], capture_output=True, text=True).stdout
    found = {}
    for line in out.splitlines():
        parts = line.strip().split(None, 2)
        # The main process is started by launchd; the backend and helpers are its children.
        if len(parts) == 3 and parts[1] == '1' and parts[2].startswith(str(binary)):
            rest = parts[2][len(str(binary)):].split()
            # The binary also runs scripts as plain Node (the t3 CLI, connect.mjs). Those are not the app,
            # and one left behind by a parent that exited also has launchd as its parent.
            if rest and not rest[0].startswith('-'):
                continue
            found[int(parts[0])] = any(arg.startswith('--inspect-brk') for arg in rest)
    return found


def mac_app_pid(pid, action='check'):
    """Whether pid is a running macOS app (not a background process); with action='quit', asks only it to quit."""
    script = (f"ObjC.import('AppKit'); var a = $.NSRunningApplication.runningApplicationWithProcessIdentifier({int(pid)});"
              f" a.isNil() ? 'none' : ({'a.terminate, ' if action == 'quit' else ''}'app')")
    return subprocess.run(['osascript', '-l', 'JavaScript', '-e', script],
                          capture_output=True, text=True).stdout.strip() == 'app'


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def mac_quit_and_wait(pid, timeout=20):
    """Quits the one T3 Code process pid, leaving any other running instance alone."""
    mac_app_pid(pid, 'quit')
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not pid_alive(pid):
            return True
        time.sleep(0.5)
    return False


def cmd_watch(args):
    """Reopens T3 Code with the customization when something starts it stock."""
    if not MAC:
        raise Stop('watch is for macOS.')
    app = find_app()
    binary = mac_binary(app)
    # Instances already running when the watcher starts are left alone, so loading it never quits T3 Code.
    seen = set(mac_main_processes(binary))
    quiet_until = 0.0
    say(time.strftime('%Y-%m-%d %H:%M:%S') + ' Watching for T3 Code started without the customization.')
    while True:
        time.sleep(1)
        for pid, hooked in mac_main_processes(binary).items():
            if pid in seen:
                continue
            seen.add(pid)
            target, notice = launch_target()
            # Only when the customization is on and current, and never twice in a row, so a failed
            # relaunch that opens stock does not loop.
            if hooked or target == app or notice or time.time() < quiet_until:
                continue
            # Give it a moment to finish starting, so the quit request is received.
            time.sleep(1.5)
            # Only a real app window counts; a short-lived process that is gone or not an app is ignored.
            if not pid_alive(pid) or not mac_app_pid(pid):
                continue
            quiet_until = time.time() + 60
            say(time.strftime('%Y-%m-%d %H:%M:%S') + f' T3 Code {pid} started stock; reopening it with the customization.')
            if not mac_quit_and_wait(pid):
                say('T3 Code did not quit; leaving it running stock.')
                continue
            launch_mac(app, target, [])
        if not mac_running():
            seen.clear()


def cmd_launch(args):
    appimage = find_app()
    target, notice = launch_target()
    if notice:
        notify('Opening stock T3 Code', notice)
    if MAC:
        return launch_mac(appimage, target, args.rest)
    if target != appimage:
        # Run the extracted copy as if it were the AppImage, so T3's own updater still updates the real file.
        os.environ['APPIMAGE'] = str(appimage)
        os.environ['APPDIR'] = str(target.parent)
    os.execv(str(target), [str(target), *args.rest])


def cmd_status(args):
    appimage = find_app()
    state = load(STATE, {})
    target, notice = launch_target()
    say('Installed T3 Code:  ' + str(appimage))
    say('Customized build:   ' + (f"{state['version']} (built {state['builtAt']})" if state else 'none yet'))
    say('Switched:           ' + ('off' if DISABLED.exists() else 'on'))
    say('Next launch opens:  ' + ('customized build' if target != appimage else 'stock T3 Code'))
    entries, chosen = catalog(), [entry['id'] for entry in selection()]
    off = [entry['id'] for entry in entries if entry['id'] not in chosen]
    say(f'Patches:            {len(chosen)} of {len(entries)} on' + (f' (off: {", ".join(off)})' if off else ''))
    if notice:
        say(notice)
    elif state and state.get('patches', chosen) != chosen:
        say(f'The patch selection changed since the last build. Run {NAME} to rebuild with it.')


def cmd_patches(args):
    """List the patches, or turn some on or off for the next build."""
    entries = catalog()
    ids = [entry['id'] for entry in entries]

    def resolve(names):
        found = []
        for name in names:
            if name.isdigit() and 1 <= int(name) <= len(ids):
                found.append(ids[int(name) - 1])
            elif name in ids:
                found.append(name)
            else:
                raise Stop(f'No patch "{name}". Run {NAME} patches to list them.')
        return found

    off = switched_off() & set(ids)
    before = [entry['id'] for entry in selection(entries, off)]

    def change(action, names):
        nonlocal off
        for pid in resolve(names):
            if action == 'on':
                extra = requirements(entries, pid) & off - {pid}
                off -= requirements(entries, pid)
            else:
                extra = dependents(entries, pid) - off - {pid}
                off |= dependents(entries, pid)
            if extra:
                say(f'{pid} {"needs" if action == "on" else "is needed by"} {", ".join(sorted(extra))}; '
                    f'turned {"that" if len(extra) == 1 else "those"} {action} too.')

    if args.action == 'on' and args.all:
        off = set()
    elif args.action in ('on', 'off'):
        if not args.names:
            raise Stop(f'Name the patches to turn {args.action}, by id or number. Run {NAME} patches to list them.')
        change(args.action, args.names)

    def show():
        chosen = {entry['id'] for entry in selection(entries, off)}
        width = max(map(len, ids))
        for number, entry in enumerate(entries, 1):
            needs = f'  (needs {", ".join(entry["requires"])})' if entry['requires'] else ''
            say(f'  {number:2} [{"x" if entry["id"] in chosen else " "}] {entry["id"]:<{width}}  {entry["title"]}{needs}')

    show()
    if args.action is None and interactive():
        while True:
            answer = input('\nToggle patches (numbers or ids, separated by spaces; Enter when done): ').split()
            if not answer:
                break
            try:
                for pid in resolve(answer):
                    on_now = pid in {entry['id'] for entry in selection(entries, off)}
                    change('off' if on_now else 'on', [pid])
            except Stop as problem:
                say(str(problem))
                continue
            say()
            show()
    after = [entry['id'] for entry in selection(entries, off)]
    save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'disabledPatches': sorted(off)})
    if after == before:
        return
    if not after:
        say(f'\nEvery patch is off. Use {NAME} off to open stock T3 Code instead.')
        return
    if args.action is None and interactive():
        if input('\nRebuild now with this selection? [Y/n] ').strip().lower() in ('', 'y', 'yes'):
            os.execv(sys.executable, [sys.executable, str(REPO / NAME), 'build'])
    say(f'\nRun {NAME} to rebuild with this selection.')


def cmd_on(args):
    DISABLED.unlink(missing_ok=True)
    say('Customization on. Quit T3 Code fully and reopen it.')


def cmd_off(args):
    DATA.mkdir(parents=True, exist_ok=True)
    DISABLED.touch()
    say('Stock T3 Code on the next launch. Quit it fully and reopen it.')


def cmd_uninstall(args):
    if BIN.is_symlink() and BIN.resolve() == (REPO / NAME).resolve():
        BIN.unlink()
    DESKTOP.unlink(missing_ok=True)
    shutil.rmtree(MAC_LAUNCHER, ignore_errors=True)
    if MAC:
        remove_mac_agents()
    for folder in (DATA, CACHE, CONFIG):
        shutil.rmtree(folder, ignore_errors=True)
    tail = '' if DATA in REPO.parents else f' You can delete {REPO} too.'
    say('Removed t3code-customize, its launcher, builds and caches. Your T3 Code and its data are untouched.' + tail)


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog='With no command, it updates the patches and builds for your installed T3 Code.')
    sub = parser.add_subparsers(dest='command')

    def build_options(p):
        p.add_argument('--appimage', '--app', help='path to your T3 Code AppImage, or T3 Code (Nightly).app on macOS (remembered)')
        p.add_argument('--fix', choices=sorted(AGENTS), help='if a nightly breaks the patches, let this agent port them without asking')
        p.add_argument('--resume', action='store_true', help='continue from the source checkout as you or your agent left it')
        p.add_argument('--skip-checks', action='store_true', help='skip the patch tests and typechecks')
        p.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
        p.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')

    build_options(sub.add_parser('build', help='update the patches and build (the default)'))
    launch = sub.add_parser('launch', help='open the customized build if it matches your T3 Code, else stock')
    launch.add_argument('rest', nargs=argparse.REMAINDER)
    sub.add_parser('status', help='show what the next launch opens')
    sub.add_parser('on', help='use the customized build')
    sub.add_parser('off', help='go back to stock T3 Code')
    chooser = sub.add_parser('patches', help='list the patches and turn single ones on or off',
                             description='List the patches, or pick which ones the next build includes. Without arguments in a '
                                         'terminal, it asks which to toggle. Turning one on also turns on what it needs; '
                                         'turning one off also turns off what needs it.')
    chooser.add_argument('action', nargs='?', choices=('on', 'off'), help='turn the named patches on or off')
    chooser.add_argument('names', nargs='*', help='patch ids or numbers, as the list shows them')
    chooser.add_argument('--all', action='store_true', help='with on: turn every patch on')
    sub.add_parser('verify', help='apply the patches to their base and run the checks (for CI)')
    sub.add_parser('uninstall', help='remove the launcher, builds and caches')
    sub.add_parser('watch', help='macOS: reopen T3 Code with the customization when it starts stock (run by a login agent)')
    argv = sys.argv[1:]
    if not argv or argv[0].startswith('-') and argv[0] not in ('-h', '--help'):
        argv = ['build', *argv]
    args = parser.parse_args(argv)
    handler = globals()['cmd_' + args.command]
    if args.command in ('launch', 'status', 'on', 'off', 'watch', 'patches'):
        return handler(args)
    CACHE.mkdir(parents=True, exist_ok=True)
    with (CACHE / 'lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Stop(f'Another {NAME} is already running.')
        handler(args)


if __name__ == '__main__':
    try:
        main()
    except Stop as stop:
        print(f'\n{stop}', file=sys.stderr)
        sys.exit(3 if isinstance(stop, NeedsFix) else 1)
    except KeyboardInterrupt:
        print('\nStopped. Your T3 Code is untouched.', file=sys.stderr)
        sys.exit(130)
